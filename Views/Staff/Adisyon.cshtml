@model Adisyon
@{
    ViewData["Title"] = "Adisyon";
    var table = (RestaurantTable)ViewBag.Table;
    var pendingVoids = (List<VoidRequest>?)ViewBag.PendingVoids ?? new List<VoidRequest>();
    var canOrder = User.HasClaim(Permissions.ClaimType, Permissions.Orders.Create);
}
<h3 class="mb-1">@table.Name - Adisyon</h3>
<p class="text-muted">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>


@if (Model == null)
{
    <p class="text-muted">Bu masada şu anda aktif bir adisyon yok.</p>
    <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
}
else
{
    <p>
        Durum: <span class="badge bg-info text-dark">@Model.Status.Label()</span>
        @if (Model.DiscountAmount > 0)
        {
            <span class="badge bg-success">İndirim: @Model.DiscountAmount.ToString("0.00") ₺</span>
        }
    </p>

    <table class="table">
        <thead><tr><th>Ürün</th><th>Adet</th><th>Fiyat</th><th>Tutar</th><th>Durum</th><th class="d-print-none"></th></tr></thead>
        <tbody>
        @foreach (var order in Model.Orders.Where(o => !o.IsDraft && o.Status != OrderStatus.IptalEdildi))
        {
            @foreach (var item in order.Items.Where(i => i.Status != OrderStatus.IptalEdildi))
            {
                <tr>
                    <td>
                        @item.MenuItemName
                        @if (item.Options.Any())
                        {
                            <div class="text-muted small">+ @string.Join(", ", item.Options.Select(o => o.Name))</div>
                        }
                    </td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("0.00") ₺</td>
                    <td>@item.LineTotal.ToString("0.00") ₺</td>
                    <td><span class="small text-muted">@item.Status.Label()</span></td>
                    <td class="text-end d-print-none">
                        @if (canOrder && !Model.IsClosed)
                        {
                            if (pendingVoids.Any(v => v.OrderItemId == item.Id))
                            {
                                <span class="badge bg-warning text-dark">İptal onayı bekliyor</span>
                            }
                            else if (item.Status == OrderStatus.Yeni)
                            {
                                <form asp-action="CancelItem" method="post" class="d-inline" data-confirm="@item.MenuItemName iptal edilecek, stoğu geri eklenecek." data-confirm-title="Kalem iptal edilsin mi?" data-confirm-ok="İptal Et" data-confirm-danger>
                                    <input type="hidden" name="orderItemId" value="@item.Id" />
                                    <input type="hidden" name="tableId" value="@table.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> İptal</button>
                                </form>
                            }
                            else
                            {
                                <details class="d-inline-block text-start">
                                    <summary class="btn btn-sm btn-outline-danger">İptal talebi</summary>
                                    <form asp-action="RequestItemCancel" method="post" class="mt-2 d-flex gap-1">
                                        <input type="hidden" name="adisyonId" value="@Model.Id" />
                                        <input type="hidden" name="orderItemId" value="@item.Id" />
                                        <input type="hidden" name="tableId" value="@table.Id" />
                                        <input type="text" name="reason" class="form-control form-control-sm" placeholder="Gerekçe" maxlength="300" required />
                                        <button type="submit" class="btn btn-sm btn-danger">Gönder</button>
                                    </form>
                                </details>
                            }
                        }
                    </td>
                </tr>
            }
        }
        </tbody>
        <tfoot>
            <tr><th colspan="3">Ara Toplam</th><th colspan="3">@Model.ItemsTotal.ToString("0.00") ₺</th></tr>
            @if (Model.DiscountAmount > 0)
            {
                <tr><th colspan="3">İndirim</th><th colspan="3">-@Model.DiscountAmount.ToString("0.00") ₺</th></tr>
            }
            <tr><th colspan="3">Genel Toplam</th><th colspan="3">@Model.GrandTotal.ToString("0.00") ₺</th></tr>
            @if (Model.PaidTotal > 0)
            {
                <tr><th colspan="3">Ödenen</th><th colspan="3">@Model.PaidTotal.ToString("0.00") ₺</th></tr>
                <tr><th colspan="3">Kalan</th><th colspan="3">@Model.RemainingTotal.ToString("0.00") ₺</th></tr>
            }
        </tfoot>
    </table>

    @if (Model.DiscountRequests.Any(d => d.Status == DiscountRequestStatus.Beklemede))
    {
        <div class="alert alert-warning small">Bekleyen indirim talebiniz var, yönetici onayı bekleniyor.</div>
    }

    <div class="d-flex gap-2 flex-wrap mb-4">
        @if (Model.Status == AdisyonStatus.Acik || Model.Status == AdisyonStatus.HesapIstendi)
        {
            <form asp-action="KasayaGonder" method="post">
                <input type="hidden" name="adisyonId" value="@Model.Id" />
                <button type="submit" class="btn btn-success">Kasaya Gönder</button>
            </form>
        }
        else
        {
            <span class="text-muted align-self-center">Adisyon kasaya gönderildi, ödeme kasa tarafından onaylanacak.</span>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">Geri Dön</a>
        <button type="button" class="btn btn-outline-dark" data-print-url="@Url.Action("Yazdir", "Staff", new { id = Model.Id })">🖨 Yazdır</button> <a class="btn btn-link btn-sm" href="@Url.Action("Yazdir", "Staff", new { id = Model.Id })?onizleme=1" target="_blank" rel="noopener">Önizle</a>
@if (ViewBag.TransferPanel is TransferPanel transferPanel)
{
    <div class="mt-3"><partial name="_TableTransfer" model="transferPanel" /></div>
}
    </div>

    @if (canOrder && !Model.IsClosed && Model.PaidTotal == 0)
    {
        if (pendingVoids.Any(v => v.Type == VoidRequestType.AdisyonIptali))
        {
            <div class="alert alert-warning small">Bu adisyon için iptal talebi yönetici onayı bekliyor.</div>
        }
        else
        {
            <details class="mb-4">
                <summary class="btn btn-sm btn-outline-danger">Adisyonu iptal et</summary>
                <form asp-action="RequestAdisyonCancel" method="post" class="row g-2 align-items-end mt-2">
                    <input type="hidden" name="adisyonId" value="@Model.Id" />
                    <input type="hidden" name="tableId" value="@table.Id" />
                    <div class="col-md-6">
                        <label class="form-label small">Gerekçe (ör. müşteri sipariş vermeden ayrıldı)</label>
                        <input type="text" name="reason" class="form-control" maxlength="300" required />
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-danger">İptal talebi gönder</button>
                    </div>
                </form>
            </details>
        }
    }

    @if (canOrder)
    {
        <h5>İndirim Talebi</h5>
        <form asp-action="RequestDiscount" method="post" class="row g-2 align-items-end mb-4">
            <input type="hidden" name="adisyonId" value="@Model.Id" />
            <div class="col-auto">
                <label class="form-label small">Tutar (₺)</label>
                <input type="number" step="0.01" min="0.01" name="amount" class="form-control" required />
            </div>
            <div class="col-auto">
                <label class="form-label small">Sebep</label>
                <input type="text" name="reason" class="form-control" placeholder="Örn: müşteri memnuniyeti" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-secondary">Talep Oluştur</button>
            </div>
        </form>
    }

}
