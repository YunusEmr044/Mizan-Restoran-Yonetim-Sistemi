@model List<RestoranYonetim.Controllers.NotificationListItem>
@{
    ViewData["Title"] = "Bildirimler";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Bildirimler</h2>
    <form asp-action="MarkAllRead" method="post">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Hepsini Okundu İşaretle</button>
    </form>
</div>

<div class="list-group">
    @foreach (var item in Model)
    {
        var n = item.Notification;
        <div class="list-group-item d-flex justify-content-between align-items-start @(item.IsRead ? "" : "list-group-item-warning")">
            <div>
                <div>@n.Message</div>
                <div class="text-muted small">@n.CreatedAt.ToString("dd.MM.yyyy HH:mm")</div>
            </div>
            <div class="d-flex gap-2">
                @if (!string.IsNullOrEmpty(n.Link))
                {
                    <a href="@n.Link" class="btn btn-sm btn-outline-primary">Git</a>
                }
                @if (!item.IsRead)
                {
                    <form asp-action="MarkRead" asp-route-id="@n.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Okundu</button>
                    </form>
                }
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted">Henüz bildirim yok.</p>
    }
</div>
