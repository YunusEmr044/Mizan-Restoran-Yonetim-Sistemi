@model Order
@{
    ViewData["Title"] = "Sipariş Alındı";
    Layout = "_CustomerLayout";
}
<style>
    .confirmation-page { min-height:calc(100vh - 2rem); background:linear-gradient(135deg,var(--cust-dark),var(--cust-dark)); color:#fff; padding:clamp(2rem,8vw,6rem) 1rem; }
    .confirmation-panel { max-width:700px; margin:auto; text-align:center; }
    .confirmation-icon { width:76px; height:76px; display:flex; align-items:center; justify-content:center; margin:0 auto 1.4rem; border-radius:50%; background:linear-gradient(135deg,var(--cust-primary-light),var(--cust-primary)); color:var(--cust-dark); font-size:2.1rem; }
    .confirmation-page h1 { font:700 clamp(2rem,5vw,3.2rem) var(--cust-heading-font); }
    .confirmation-number { color:#d8c9b2; }
    .confirmation-card { background:#fff; color:#2d241c; border-radius:20px; padding:1rem; text-align:left; box-shadow:0 20px 45px rgba(0,0,0,.22); }
    .confirmation-item { display:flex; justify-content:space-between; padding:.9rem; border-bottom:1px solid #eee5d8; }
    .confirmation-item:last-child { border-bottom:0; }
    .confirmation-total { color:var(--cust-primary); font-weight:700; font-size:1.2rem; }
    .confirmation-primary { display:inline-block; border-radius:999px; padding:.8rem 1.3rem; background:linear-gradient(135deg,var(--cust-primary-light),var(--cust-primary)); color:var(--cust-dark); text-decoration:none; font-weight:700; }
    .confirmation-link { color:var(--cust-primary-light); margin-left:.8rem; }
    @@media (max-width:520px) { .confirmation-link { display:block; margin:1rem 0 0; } }
</style>
<div class="confirmation-page">
<div class="confirmation-panel">
    <div class="confirmation-icon">✓</div>
    <h1 class="mb-3">Siparişiniz alındı!</h1>
    <p class="confirmation-number">Sipariş No: #@Model.Id</p>
    <div class="confirmation-card mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="confirmation-item">
                <span>@item.MenuItemName x @item.Quantity</span>
                <strong>@item.LineTotal.ToString("0.00") ₺</strong>
            </div>
        }
        <div class="d-flex justify-content-between pt-3 px-2"><strong>Toplam</strong><span class="confirmation-total">@Model.Total.ToString("0.00") ₺</span></div>
    </div>
    <a class="confirmation-primary" asp-action="Index" asp-route-token="@Model.Table!.QrToken">Menüye Dön →</a>
    <a class="confirmation-link" asp-controller="Home" asp-action="Degerlendirme" asp-route-masa="@Model.TableId">Deneyiminizi değerlendirin</a>
</div>
</div>
