@model Order
@{
    ViewData["Title"] = T["Sipariş Alındı"];
    Layout = "_CustomerLayout";
    var names = ViewBag.ItemNames as IReadOnlyDictionary<int, string>;
}
<div class="confirmation-page">
<div class="confirmation-panel">
    <div class="confirmation-icon">✓</div>
    <h1 class="mb-3">@T["Siparişiniz alındı!"]</h1>
    <p class="confirmation-number">@T["Sipariş No:"] #@Model.Id</p>
    <div class="confirmation-card mb-4">
        @foreach (var item in Model.Items)
        {
            <div class="confirmation-item">
                <span>@(names?.GetValueOrDefault(item.MenuItemId) ?? item.MenuItemName) x @item.Quantity</span>
                <strong>@item.LineTotal.ToString("0.00") ₺</strong>
            </div>
        }
        <div class="d-flex justify-content-between pt-3 px-2"><strong>@T["Toplam"]</strong><span class="confirmation-total">@Model.Total.ToString("0.00") ₺</span></div>
    </div>
    <a class="confirmation-primary" asp-action="Index" asp-route-token="@Model.Table!.QrToken">@T["Menüye Dön"] →</a>
    <a class="confirmation-link" asp-controller="Home" asp-action="Degerlendirme" asp-route-masa="@Model.TableId">@T["Deneyiminizi değerlendirin"]</a>
</div>
</div>
