@model Order
@{
    ViewData["Title"] = T["Sepetim"];
    Layout = "_CustomerLayout";
    var names = ViewBag.ItemNames as IReadOnlyDictionary<int, string>;
    var optionNames = ViewBag.OptionNames as IReadOnlyDictionary<string, string>;
}
<div class="customer-page">
<div class="customer-panel">
<div class="customer-eyebrow">@T["Sipariş özeti"]</div>
<h1 class="mb-2">@T["Sepetiniz"]</h1>
<p style="color:#d8c9b2;">@T["Göndermeden önce kontrol edin. Onayladığınızda siparişiniz mutfağa ve bara iletilecek."]</p>

<div class="customer-card mb-4">
    @foreach (var item in Model.Items)
    {
        <div class="customer-item">
            <div>
                <span>@(names?.GetValueOrDefault(item.MenuItemId) ?? item.MenuItemName) x @item.Quantity</span>
                @if (item.Options.Any())
                {
                    <div class="text-muted small mt-1">+ @string.Join(", ", item.Options.Select(o => optionNames?.GetValueOrDefault(o.Name) ?? o.Name))</div>
                }
            </div>
            <strong>@item.LineTotal.ToString("0.00") ₺</strong>
        </div>
    }
    </div>

@if (!string.IsNullOrEmpty(Model.Notes))
{
    <p class="text-muted small">@T["Not:"] @Model.Notes</p>
}

<div class="d-flex justify-content-between align-items-center mb-4"><span style="color:#d8c9b2;">@T["Toplam"]</span><span class="customer-total">@Model.Total.ToString("0.00") ₺</span></div>

<form asp-action="OnaylaVeGonder" asp-route-token="@Model.Table!.QrToken" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="customer-primary w-100 mb-3">@T["Siparişi Onayla ve Gönder"] <span class="ms-1">→</span></button>
</form>
<a class="customer-secondary w-100 text-center" asp-action="Index" asp-route-token="@Model.Table!.QrToken">← @T["Menüye Dön"]</a>
</div>
</div>
