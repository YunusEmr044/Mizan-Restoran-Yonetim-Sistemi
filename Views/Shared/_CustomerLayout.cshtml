@{
    string primary = ViewBag.ThemePrimaryColor ?? RestoranYonetim.Models.ThemeCatalog.DefaultPrimary;
    string primaryLight = ViewBag.ThemePrimaryLightColor ?? RestoranYonetim.Models.ThemeCatalog.DefaultPrimaryLight;
    string primaryRgb = ViewBag.ThemePrimaryColorRgb ?? RestoranYonetim.Models.ThemeCatalog.HexToRgbTriplet(primary);
    string dark = ViewBag.ThemeDarkColor ?? RestoranYonetim.Models.ThemeCatalog.DefaultDark;
    string darkRgb = ViewBag.ThemeDarkColorRgb ?? RestoranYonetim.Models.ThemeCatalog.HexToRgbTriplet(dark);
    string headingFont = ViewBag.ThemeHeadingFont ?? RestoranYonetim.Models.ThemeCatalog.DefaultHeadingFont;
    IEnumerable<string> fontStylesheets = ViewBag.ThemeFontStylesheets ?? RestoranYonetim.Models.ThemeCatalog.FontStylesheets(headingFont, RestoranYonetim.Models.ThemeCatalog.DefaultBodyFont);
}
<!DOCTYPE html>
<html lang="@SiteLanguages.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @T["Menü"]</title>
    @await Component.InvokeAsync("SiteIcon")
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    @foreach (var fontHref in fontStylesheets)
    {
        <link rel="stylesheet" href="@fontHref" />
    }
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    @* Müşteri QR menüsü, herkese açık siteyle (SuperAdmin > Ayarlar) aynı temayı paylaşır -
       bkz. ThemeCatalog.ApplyToViewBag / MenuController.ApplyThemeAsync. *@
    <style>
        :root {
            --cust-primary: @primary;
            --cust-primary-rgb: @primaryRgb;
            --cust-primary-light: @primaryLight;
            --cust-dark: @dark;
            --cust-dark-rgb: @darkRgb;
            --cust-heading-font: '@headingFont', Georgia, serif;
        }
    </style>
</head>
<body style="background:#faf6ef;">
    @if (SiteLanguages.Current == SiteLanguages.Default)
    {
        @* Telefonun dili Türkçe değilse İngilizce menü önerilir; seçim cihazda hatırlanır, otomatik yönlendirme yapılmaz. *@
        <div class="customer-lang-hint" id="ryLangHint" hidden>
            <a href="@SiteLanguages.PathFor("en", Context.Request.Path, Context.Request.QueryString)" lang="en">View this menu in English →</a>
            <button type="button" aria-label="@T["Kapat"]" data-dismiss>×</button>
        </div>
        <script>
            (function () {
                var hint = document.getElementById('ryLangHint');
                var key = 'ry-lang-hint';
                var seen = null;
                try { seen = localStorage.getItem(key); } catch (e) { }
                if (seen || /^tr/i.test(navigator.language || 'tr')) { return; }
                hint.hidden = false;
                function remember() { try { localStorage.setItem(key, '1'); } catch (e) { } }
                hint.querySelector('a').addEventListener('click', remember);
                hint.querySelector('[data-dismiss]').addEventListener('click', function () { remember(); hint.hidden = true; });
            })();
        </script>
    }
    <div class="container-fluid px-0">
        @RenderBody()
    </div>
</body>
</html>
