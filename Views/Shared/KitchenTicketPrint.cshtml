@model RestoranYonetim.Services.Printing.PendingBrowserTicket
@using RestoranYonetim.Services.Printing
@{
    Layout = null;
    var t = Model.Ticket;
    var width = Model.PaperWidthMm;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@t.Title</title>
    <style>
        @@page { size: @(width)mm 200mm; margin: 0; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; background: #fff; color: #000; }
        body { font-family: "Courier New", Courier, monospace; font-size: @(width == 58 ? 12 : 14)px; line-height: 1.3; }
        .ticket { width: @(width - 6)mm; margin: 0 auto; padding: 3mm 0; }
        .center { text-align: center; }
        .void { font-size: 1.6em; font-weight: 700; letter-spacing: .1em; }
        .title { font-size: 1.7em; font-weight: 700; margin: .1em 0 .2em; }
        .sep { border-top: 1px dashed #000; margin: .4em 0; }
        .line { font-weight: 700; font-size: 1.15em; margin-top: .3em; }
        .sub { padding-left: 1.2em; }
    </style>
</head>
<body>
    <div class="ticket" id="ticket">
        <div class="center">
            @if (t.Kind == KitchenTicketKind.Iptal) { <div class="void">*** İPTAL ***</div> }
            <div class="title">@t.Title</div>
        </div>
        <div>@(t.OrderId > 0 ? $"Sipariş #{t.OrderId} · {t.At:HH:mm}" : t.At.ToString("dd.MM.yyyy HH:mm"))</div>
        @if (t.Byline != null) { <div>@t.Byline</div> }
        @if (t.PromisedAt is DateTime promised) { <div>Teslim saati: @promised.ToString("HH:mm")</div> }
        <div class="sep"></div>
        @foreach (var line in t.Lines)
        {
            <div class="line">@line.Quantity x @line.Name</div>
            @foreach (var option in line.Options) { <div class="sub">+ @option</div> }
            @if (line.Note != null) { <div class="sub">! @line.Note</div> }
            @if (line.Takeaway) { <div class="sub">[PAKET]</div> }
        }
        <div class="sep"></div>
        @if (t.OrderNote != null) { <div>Not: @t.OrderNote</div> }
        @if (t.Reason != null) { <div>Gerekçe: @t.Reason</div> }
        @if (t.Kind == KitchenTicketKind.Iptal && t.By != null) { <div>Onaylayan: @t.By</div> }
    </div>
    <script>
        (function () {
            var heightMm = Math.ceil(document.getElementById('ticket').getBoundingClientRect().height * 25.4 / 96) + 6;
            var style = document.createElement('style');
            style.textContent = '@@page { size: @(width)mm ' + heightMm + 'mm; margin: 0; }';
            document.head.appendChild(style);
            var token = '@Model.Token';
            var sent = false;
            function printed() {
                if (sent) { return; }
                sent = true;
                window.parent.postMessage({ type: 'ry-ticket-printed', token: token }, location.origin);
            }
            // print() yazdırma bitene kadar bekler; afterprint her tarayıcıda tetiklenmediği için yalnızca yedektir.
            window.addEventListener('afterprint', printed);
            window.addEventListener('load', function () { setTimeout(function () { window.print(); printed(); }, 100); });
        })();
    </script>
</body>
</html>
