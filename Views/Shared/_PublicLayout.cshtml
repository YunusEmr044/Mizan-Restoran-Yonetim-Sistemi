<!DOCTYPE html>
<html lang="@SiteLanguages.Current">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>document.documentElement.classList.add('js');</script>
    @{
        // Bu ViewBag değerleri HomeController.ApplySeoAsync tarafından önceden çözülüp yazıldı, burada tekrar hesaplanmıyor, sadece basılıyor.
        var restaurantName = ViewBag.RestaurantName as string ?? T["Restoran"];
        var pageTitle = ViewBag.SeoPageTitle as string;
        if (string.IsNullOrWhiteSpace(pageTitle))
        {
            var viewTitle = ViewData["Title"] as string;
            pageTitle = !string.IsNullOrWhiteSpace(viewTitle) ? $"{viewTitle} - {restaurantName}" : restaurantName;
        }
        var metaDescription = ViewBag.SeoMetaDescription as string ?? ViewBag.SeoDescription as string;
        var canonicalUrl = ViewBag.SeoCanonicalUrl as string;
        var noIndex = ViewBag.SeoNoIndex is true;
        var noFollow = ViewBag.SeoNoFollow is true;
        var ogTitle = ViewBag.SeoOgTitle as string ?? pageTitle;
        var ogDescription = ViewBag.SeoOgDescription as string ?? metaDescription;
        var ogImage = ViewBag.SeoOgImageUrl as string;
        var googleVerification = ViewBag.SeoGoogleVerification as string;
        var bingVerification = ViewBag.SeoBingVerification as string;
        var twitterHandle = ViewBag.SeoTwitterHandle as string;
        var structuredDataHtml = ViewBag.StructuredDataHtml as string;
    }
    <title>@pageTitle</title>
    @if (!string.IsNullOrWhiteSpace(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    <meta name="robots" content="@((noIndex ? "noindex" : "index") + "," + (noFollow ? "nofollow" : "follow"))" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    @if (ViewBag.SeoAlternates is IEnumerable<(string Lang, string Url)> alternates)
    {
        foreach (var alt in alternates)
        {
            <link rel="alternate" hreflang="@alt.Lang" href="@alt.Url" />
        }
    }
    @await Component.InvokeAsync("SiteIcon")
    @if (!string.IsNullOrWhiteSpace(googleVerification))
    {
        <meta name="google-site-verification" content="@googleVerification" />
    }
    @if (!string.IsNullOrWhiteSpace(bingVerification))
    {
        <meta name="msvalidate.01" content="@bingVerification" />
    }
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@restaurantName" />
    <meta property="og:locale" content="@SiteLanguages.OgLocale(SiteLanguages.Current)" />
    <meta property="og:title" content="@ogTitle" />
    @if (!string.IsNullOrWhiteSpace(ogDescription))
    {
        <meta property="og:description" content="@ogDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <meta property="og:url" content="@canonicalUrl" />
    }
    @if (!string.IsNullOrWhiteSpace(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }
    <meta name="twitter:card" content="@(string.IsNullOrWhiteSpace(ogImage) ? "summary" : "summary_large_image")" />
    <meta name="twitter:title" content="@ogTitle" />
    @if (!string.IsNullOrWhiteSpace(ogDescription))
    {
        <meta name="twitter:description" content="@ogDescription" />
    }
    @if (!string.IsNullOrWhiteSpace(twitterHandle))
    {
        <meta name="twitter:site" content="@("@" + twitterHandle)" />
    }
    @if (!string.IsNullOrWhiteSpace(structuredDataHtml))
    {
        @Html.Raw(structuredDataHtml)
    }
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    @foreach (var fontHref in (IEnumerable<string>)(ViewBag.ThemeFontStylesheets ?? RestoranYonetim.Models.ThemeCatalog.FontStylesheets(RestoranYonetim.Models.ThemeCatalog.DefaultHeadingFont, RestoranYonetim.Models.ThemeCatalog.DefaultBodyFont)))
    {
        <link rel="stylesheet" href="@fontHref" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --py-bg: @(ViewBag.ThemeDarkColor ?? "#100d0a");
            --py-bg-rgb: @(ViewBag.ThemeDarkColorRgb ?? "16, 13, 10");
            --py-bg-soft: var(--py-bg);
            --py-gold: @(ViewBag.ThemePrimaryColor ?? "#cd9f56");
            --py-gold-rgb: @(ViewBag.ThemePrimaryColorRgb ?? "205, 159, 86");
            --py-gold-light: @(ViewBag.ThemePrimaryLightColor ?? "#f0cf94");
            --py-cream: @(ViewBag.ThemeBackgroundColor ?? "#faf6ef");
            --py-text: @(ViewBag.ThemeTextColor ?? "#2a2117");
            --py-muted: #8c7f6d;
            --py-radius: @(ViewBag.ThemeCardRadius ?? "18px");
            --py-btn-radius: @(ViewBag.ThemeButtonRadius ?? "999px");
            --py-heading-font: '@(ViewBag.ThemeHeadingFont ?? "Playfair Display")', serif;
            --py-body-font: '@(ViewBag.ThemeBodyFont ?? "Poppins")', sans-serif;
            --py-on-gold: @(ViewBag.ThemeOnPrimary ?? "#1a1410");
        }
    </style>
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
</head>
@{ var showMobileCta = ViewData["HideMobileCta"] is not true; }
<body class="py-body@(showMobileCta ? " has-mobile-cta" : "")">
    <nav class="navbar navbar-expand-lg py-navbar" id="pyNavbar">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(ViewBag.LogoImageUrl as string))
                {
                    <img src="@ViewBag.LogoImageUrl" alt="@(ViewBag.RestaurantName ?? T["Restoran"])" style="max-height:42px; max-width:150px; object-fit:contain;" />
                }
                else
                {
                    @(ViewBag.RestaurantName ?? T["Restoranımız"])
                }
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#publicMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="publicMenu">
                <ul class="navbar-nav ms-auto align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">@T["Ana Sayfa"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Menu">@T["Menü"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Hakkimizda">@T["Hakkımızda"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Galeri">@T["Galeri"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Iletisim">@T["İletişim"]</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Sss">@T["SSS"]</a></li>
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                        <a class="btn btn-py-gold btn-sm" asp-controller="Home" asp-action="Rezervasyon">
                            <i class="bi bi-calendar-check me-1"></i>@T["Rezervasyon"]
                        </a>
                    </li>
                    <li class="nav-item ms-lg-2 mt-2 mt-lg-0"><partial name="_LanguageSwitch" /></li>
                </ul>
            </div>
        </div>
    </nav>

    @if (TempData["Error"] != null)
    {
        <div class="container mt-3"><div class="alert alert-danger shadow-sm">@TempData["Error"]</div></div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="container mt-3"><div class="alert alert-success shadow-sm">@TempData["Info"]</div></div>
    }

    <partial name="_Breadcrumbs" model="@(ViewBag.Breadcrumb as List<(string Name, string? Url)>)" />

    @RenderBody()

    <footer class="py-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5 class="mb-3">@(ViewBag.RestaurantName ?? T["Restoranımız"])</h5>
                    <p class="small text-white-50">@(string.IsNullOrWhiteSpace(ViewBag.FooterTagline as string) ? T["Lezzet ve misafirperverliği bir araya getiriyoruz. Sizi ağırlamak için sabırsızlanıyoruz."] : ViewBag.FooterTagline)</p>
                    <div class="d-flex gap-2 mt-3">
                        @if (!string.IsNullOrEmpty(ViewBag.FacebookUrl))
                        {
                            <a href="@ViewBag.FacebookUrl" target="_blank" rel="noopener" class="py-social-icon"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.InstagramUrl))
                        {
                            <a href="@ViewBag.InstagramUrl" target="_blank" rel="noopener" class="py-social-icon"><i class="bi bi-instagram"></i></a>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <h5 class="mb-3">@T["Hızlı Bağlantılar"]</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Menu"><i class="bi bi-chevron-right small me-1"></i>@T["Menü"]</a></li>
                        <li><a asp-controller="Home" asp-action="Hakkimizda"><i class="bi bi-chevron-right small me-1"></i>@T["Hakkımızda"]</a></li>
                        <li><a asp-controller="Home" asp-action="Galeri"><i class="bi bi-chevron-right small me-1"></i>@T["Galeri"]</a></li>
                        <li><a asp-controller="Home" asp-action="Rezervasyon"><i class="bi bi-chevron-right small me-1"></i>@T["Rezervasyon"]</a></li>
                        <li><a asp-controller="Home" asp-action="Sss"><i class="bi bi-chevron-right small me-1"></i>@T["Sıkça Sorulan Sorular"]</a></li>
                        <li><a asp-controller="Home" asp-action="Degerlendirme"><i class="bi bi-chevron-right small me-1"></i>@T["Değerlendirme"]</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="mb-3">@T["İletişim"]</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        @if (!string.IsNullOrEmpty(ViewBag.ContactPhone))
                        {
                            <li><i class="bi bi-telephone me-2"></i>@ViewBag.ContactPhone</li>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.ContactAddress))
                        {
                            <li><i class="bi bi-geo-alt me-2"></i>@ViewBag.ContactAddress</li>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.ContactEmail))
                        {
                            <li><i class="bi bi-envelope me-2"></i>@ViewBag.ContactEmail</li>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.WorkingHours))
                        {
                            <li><i class="bi bi-clock me-2"></i>@ViewBag.WorkingHours</li>
                        }
                        @if (!string.IsNullOrEmpty(ViewBag.WhatsAppNumber))
                        {
                            <li><a href="https://wa.me/@(ViewBag.WhatsAppNumber)?text=@(Uri.EscapeDataString((string?)ViewBag.WhatsAppDefaultMessage ?? T["Merhaba, bilgi almak istiyorum."]))" target="_blank" rel="noopener"><i class="bi bi-whatsapp me-2"></i>WhatsApp</a></li>
                        }
                    </ul>
                </div>
            </div>
            <div class="text-center small text-white-50 mt-4 pt-4" style="border-top: 1px solid rgba(255,255,255,.08);">
                @await Component.InvokeAsync("LegalLinks")
                &copy; @DateTime.Now.Year @(ViewBag.RestaurantName ?? T["Restoranımız"]) — @T["Tüm hakları saklıdır."]
                <div class="py-powered">
                    <img src="~/img/logo-mark.svg" alt="" />@T["Altyapı:"] <strong>@ProductInfo.Name</strong> @T["Restoran Yönetim Sistemi"]
                </div>
            </div>
        </div>
    </footer>

    @if (!string.IsNullOrEmpty(ViewBag.WhatsAppNumber))
    {
        <a id="py-whatsapp-btn" href="https://wa.me/@(ViewBag.WhatsAppNumber)?text=@(Uri.EscapeDataString((string?)ViewBag.WhatsAppDefaultMessage ?? T["Merhaba, bilgi almak istiyorum."]))" target="_blank" rel="noopener" aria-label="@T["WhatsApp'tan yazın"]"><i class="bi bi-whatsapp"></i></a>
    }
    <button id="py-top-btn" aria-label="@T["Yukarı çık"]"><i class="bi bi-arrow-up"></i></button>
    @if (showMobileCta)
    {
        <a class="py-mobile-cta btn btn-py-gold" asp-controller="Home" asp-action="Rezervasyon"><i class="bi bi-calendar-check me-2"></i>@T["Rezervasyon Yap"]</a>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/form-busy.js" asp-append-version="true"></script>
    <script src="~/js/map-embed.js" asp-append-version="true"></script>
    @await Component.InvokeAsync("Consent")
    <script>
        (function () {
            var nav = document.getElementById('pyNavbar');
            var topBtn = document.getElementById('py-top-btn');
            function onScroll() {
                var y = window.scrollY || document.documentElement.scrollTop;
                if (nav) { nav.classList.toggle('py-scrolled', y > 40); }
                if (topBtn) { topBtn.classList.toggle('py-show', y > 420); }
            }
            document.addEventListener('scroll', onScroll, { passive: true });
            onScroll();
            if (topBtn) {
                topBtn.addEventListener('click', function () {
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // Scroll reveal animations
            var revealEls = document.querySelectorAll('.py-reveal');
            if ('IntersectionObserver' in window && revealEls.length) {
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('py-in');
                            io.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.15 });
                revealEls.forEach(function (el) { io.observe(el); });
            } else {
                revealEls.forEach(function (el) { el.classList.add('py-in'); });
            }

            // Active nav link highlight
            // Ana sayfa bağlantısı ("/" ya da "/en") yalnızca kendisinde, diğerleri alt sayfalarında da etkin görünür.
            function norm(u) { return (u || '').toLowerCase().replace(/\/+$/, '') || '/'; }
            var path = norm(window.location.pathname);
            var brand = document.querySelector('.py-navbar .navbar-brand');
            var home = norm(brand ? brand.getAttribute('href') : '/');
            document.querySelectorAll('.py-navbar .nav-link').forEach(function (a) {
                try {
                    var href = norm(a.getAttribute('href'));
                    if (href === home ? path === home : (path === href || path.indexOf(href + '/') === 0)) {
                        a.classList.add('active');
                    }
                } catch (e) { }
            });
        })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
