@model RestoranYonetim.Services.ReceiptView
@{
    Layout = null;
    var a = Model.Adisyon;
    var site = Model.Site;
    var paper = Model.Paper;
    var name = string.IsNullOrWhiteSpace(site.HeroTitle) ? "Restoran" : site.HeroTitle;
    var footer = string.IsNullOrWhiteSpace(site.ReceiptFooterText) ? "Afiyet olsun! Bizi tercih ettiğiniz için teşekkür ederiz." : site.ReceiptFooterText;
    var tableName = AdisyonLabel.For(a);
    var preview = Context.Request.Query.ContainsKey("onizleme");
    var contentWidthMm = paper.IsRoll ? paper.WidthMm - 8 : paper.WidthMm - 24;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Adisyon @a.Id - @tableName</title>
    <style>
        @@page { @(paper.IsRoll ? $"size: {paper.WidthMm}mm 200mm; margin: 0;" : $"size: {paper.CssPageSize}; margin: 12mm;") }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; background: #fff; color: #000; }
        body { font-family: Arial, Helvetica, sans-serif; font-size: @(Model.FontPx)px; line-height: 1.35; }
        body.roll { font-family: "Courier New", Courier, monospace; }
        .receipt { width: @(contentWidthMm)mm; margin: 0 auto; padding: @(paper.IsRoll ? "3mm 0" : "0"); }
        .center { text-align: center; }
        .name { font-size: 1.35em; font-weight: 700; }
        .small { font-size: .85em; }
        .title { font-weight: 700; letter-spacing: .1em; margin-top: .3em; }
        .sep { border-top: 1px dashed #000; margin: .45em 0; }
        .row { display: flex; justify-content: space-between; gap: .5em; }
        .row > span:last-child { text-align: right; white-space: nowrap; }
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; border-bottom: 1px solid #000; font-weight: 700; padding-bottom: .2em; }
        td { padding: .2em 0; vertical-align: top; }
        .num { text-align: right; white-space: nowrap; padding-left: .4em; }
        .sub { font-size: .85em; padding-left: .5em; }
        .grand { font-size: 1.2em; font-weight: 700; margin-top: .2em; }
        .legal { font-weight: 700; margin-top: .4em; }
        @@media screen { body { background: #eee; } .receipt { background: #fff; padding: 4mm; margin: 6mm auto; box-shadow: 0 2px 10px rgba(0,0,0,.15); } }
    </style>
</head>
<body class="@(paper.IsRoll ? "roll" : "sheet")">
    <div class="receipt" id="receipt">
        <div class="center">
            <div class="name">@name</div>
            @if (site.ReceiptShowAddress && !string.IsNullOrWhiteSpace(site.ContactAddress))
            {
                <div class="small">@site.ContactAddress</div>
            }
            @if (site.ReceiptShowPhone && !string.IsNullOrWhiteSpace(site.ContactPhone))
            {
                <div class="small">Tel: @site.ContactPhone</div>
            }
            @if (!string.IsNullOrWhiteSpace(site.ReceiptTaxInfo))
            {
                <div class="small">@site.ReceiptTaxInfo</div>
            }
            <div class="title">ADİSYON</div>
        </div>
        <div class="sep"></div>
        @if (a.OrderType == OrderType.Masa)
        {
            <div class="row"><span>Masa:</span><span>@tableName@(string.IsNullOrWhiteSpace(Model.AreaName) ? "" : $" ({Model.AreaName})")</span></div>
        }
        else
        {
            <div class="row"><span>Tür:</span><span>@a.OrderType.Label() #@a.Id</span></div>
            @if (!string.IsNullOrWhiteSpace(a.Package?.CustomerName)) { <div class="row"><span>Müşteri:</span><span>@a.Package.CustomerName</span></div> }
            @if (!string.IsNullOrWhiteSpace(a.Package?.CustomerPhone)) { <div class="row"><span>Telefon:</span><span>@a.Package.CustomerPhone</span></div> }
            @if (a.Package?.PromisedAt is DateTime promised) { <div class="row"><span>Teslim:</span><span>@promised.ToString("HH:mm")</span></div> }
            @if (!string.IsNullOrWhiteSpace(a.Package?.Address)) { <div class="small">Adres: @a.Package.Address</div> }
            @if (!string.IsNullOrWhiteSpace(a.Package?.Note)) { <div class="small">Not: @a.Package.Note</div> }
        }
        <div class="row"><span>Adisyon No:</span><span>@a.Id</span></div>
        <div class="row"><span>Açılış:</span><span>@a.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span></div>
        <div class="row"><span>Yazdırma:</span><span>@Model.PrintedAt.ToString("dd.MM.yyyy HH:mm")</span></div>
        @if (site.ReceiptShowWaiter && Model.Waiters != null)
        {
            <div class="row"><span>Garson:</span><span>@Model.Waiters</span></div>
        }
        <div class="sep"></div>
        <table>
            <thead><tr><th>Ürün</th><th class="num">Ad.</th><th class="num">Tutar</th></tr></thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @item.MenuItemName@(item.IsTakeaway && a.OrderType == OrderType.Masa ? " (paket)" : "")
                        @if (item.Quantity > 1)
                        {
                            <div class="sub">@item.Quantity x @ReceiptLayout.Money(item.UnitPrice + item.OptionsUnitPrice)</div>
                        }
                        @if (item.Options.Any())
                        {
                            <div class="sub">+ @string.Join(", ", item.Options.Select(o => o.Name))</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                        {
                            <div class="sub">Not: @item.Notes</div>
                        }
                    </td>
                    <td class="num">@item.Quantity</td>
                    <td class="num">@ReceiptLayout.Money(item.LineTotal)</td>
                </tr>
            }
            </tbody>
        </table>
        <div class="sep"></div>
        <div class="row"><span>Ara Toplam</span><span>@ReceiptLayout.Money(a.ItemsTotal) TL</span></div>
        @if (a.DiscountAmount > 0)
        {
            <div class="row"><span>İndirim@(string.IsNullOrWhiteSpace(a.DiscountReason) ? "" : $" ({a.DiscountReason})")</span><span>-@ReceiptLayout.Money(a.DiscountAmount) TL</span></div>
        }
        <div class="row grand"><span>TOPLAM</span><span>@ReceiptLayout.Money(a.GrandTotal) TL</span></div>
        @if (a.PaidTotal > 0)
        {
            @if (site.ReceiptShowPayments)
            {
                @foreach (var (method, amount) in Model.Payments)
                {
                    <div class="row small"><span>@method</span><span>@ReceiptLayout.Money(amount) TL</span></div>
                }
            }
            <div class="row"><span>Ödenen</span><span>@ReceiptLayout.Money(a.PaidTotal) TL</span></div>
            @if (a.RemainingTotal > 0)
            {
                <div class="row"><span>Kalan</span><span>@ReceiptLayout.Money(a.RemainingTotal) TL</span></div>
            }
        }
        <div class="sep"></div>
        <div class="center">
            <div class="small">Fiyatlarımıza KDV dahildir.</div>
            <div>@footer</div>
            <div class="small legal">Bu belge bilgi fişidir, mali değeri yoktur.</div>
        </div>
    </div>
    @if (!preview)
    {
        <script>
            (function () {
                @if (paper.IsRoll)
                {
                    @:var receipt = document.getElementById('receipt');
                    @:var heightMm = Math.ceil(receipt.getBoundingClientRect().height * 25.4 / 96) + 6;
                    @:var style = document.createElement('style');
                    @:style.textContent = '@@page { size: @(paper.WidthMm)mm ' + heightMm + 'mm; margin: 0; }';
                    @:document.head.appendChild(style);
                }
                window.addEventListener('load', function () { setTimeout(function () { window.print(); }, 100); });
            })();
        </script>
    }
</body>
</html>
