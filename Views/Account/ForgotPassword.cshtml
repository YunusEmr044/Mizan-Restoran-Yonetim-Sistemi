@{
    ViewData["Title"] = "Şifremi unuttum";
    Layout = "_AuthLayout";
    var sent = ViewBag.Sent == true;
}
@if (sent)
{
    <p class="notice">Bu adres kayıtlı bir personel hesabına aitse şifre sıfırlama bağlantısı gönderildi. Gelen kutunuzu (ve gereksiz klasörünü) kontrol edin. Bağlantı bir kez kullanılabilir.</p>
}
else
{
    <p class="subtitle">Hesabınızın e-posta adresini girin; şifre sıfırlama bağlantısı gönderelim.</p>
    <form method="post" action="/sifremi-unuttum">
        @Html.AntiForgeryToken()
        <label for="email">E-posta</label>
        <input id="email" name="email" type="email" autocomplete="username" required autofocus />
        <button type="submit">Bağlantı gönder</button>
    </form>
}
<div class="login-note"><a href="/admin">Girişe dön</a></div>
