@model RestoranYonetim.Controllers.ResetPasswordViewModel
@{
    ViewData["Title"] = "Yeni şifre";
    Layout = "_AuthLayout";
}
<p class="subtitle">Yeni şifrenizi belirleyin. En az 8 karakter, bir rakam ve bir küçük harf içermeli.</p>
<form method="post" action="/sifre-sifirla">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="UserId" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="All" class="errors"></div>
    <label asp-for="NewPassword"></label>
    <input asp-for="NewPassword" autocomplete="new-password" autofocus />
    <label asp-for="ConfirmPassword"></label>
    <input asp-for="ConfirmPassword" autocomplete="new-password" />
    <button type="submit">Şifreyi kaydet</button>
</form>
<div class="login-note"><a href="/admin">Girişe dön</a></div>
