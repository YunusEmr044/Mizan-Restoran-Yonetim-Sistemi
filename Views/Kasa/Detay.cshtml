@using RestoranYonetim.Services
@model Adisyon
@{
    ViewData["Title"] = "Adisyon Detayı";
    var shiftOpen = (bool)ViewBag.OpenShift;
}
<h2 class="mb-1">@AdisyonLabel.For(Model) — Adisyon</h2>
<p class="text-muted">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm") — Durum: <span class="badge bg-info text-dark">@Model.Status.Label()</span>
    @if (ViewBag.FiscalReceipt is FiscalReceipt fiscal)
    {
        <span class="ms-2">Mali fiş: <span class="badge @(fiscal.Status == FiscalReceiptStatus.Kesildi ? "bg-success" : fiscal.Status is FiscalReceiptStatus.Hata or FiscalReceiptStatus.Belirsiz ? "bg-danger" : "bg-secondary")">@fiscal.Status.Label()@(fiscal.ReceiptNo == null ? "" : $" #{fiscal.ReceiptNo}")</span>
            @if (fiscal.IsSimulated) { <span class="badge bg-info text-dark">SİMÜLATÖR</span> }</span>
    }
</p>


<table class="table">
    <thead><tr><th>Ürün</th><th>Adet</th><th>Fiyat</th><th>Tutar</th></tr></thead>
    <tbody>
    @foreach (var order in Model.Orders.Where(o => !o.IsDraft && o.Status != OrderStatus.IptalEdildi))
    {
        @foreach (var item in order.Items.Where(i => i.Status != OrderStatus.IptalEdildi))
        {
            <tr>
                <td>
                    @item.MenuItemName
                    @if (item.Options.Any())
                    {
                        <div class="text-muted small">+ @string.Join(", ", item.Options.Select(o => o.Name))</div>
                    }
                </td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("0.00") ₺</td>
                <td>@item.LineTotal.ToString("0.00") ₺</td>
            </tr>
        }
    }
    </tbody>
    <tfoot>
        <tr><th colspan="3">Ara Toplam</th><th>@Model.ItemsTotal.ToString("0.00") ₺</th></tr>
        @if (Model.DiscountAmount > 0)
        {
            <tr><th colspan="3">İndirim (@Model.DiscountReason)</th><th>-@Model.DiscountAmount.ToString("0.00") ₺</th></tr>
        }
        <tr><th colspan="3">Genel Toplam</th><th>@Model.GrandTotal.ToString("0.00") ₺</th></tr>
        <tr><th colspan="3">Ödenen</th><th>@Model.PaidTotal.ToString("0.00") ₺</th></tr>
        <tr class="table-warning"><th colspan="3">Kalan</th><th>@Model.RemainingTotal.ToString("0.00") ₺</th></tr>
    </tfoot>
</table>

@{
    var pendingVoids = (List<VoidRequest>?)ViewBag.PendingVoids ?? new List<VoidRequest>();
    var canOperateCash = User.HasClaim(Permissions.ClaimType, Permissions.Cash.Operate);
    var reversedIds = Model.Payments.Where(p => p.ReversesPaymentId != null).Select(p => p.ReversesPaymentId!.Value).ToHashSet();
}
@if (Model.Payments.Any())
{
    <h6>Alınan Ödemeler</h6>
    <ul class="list-group mb-4">
        @foreach (var p in Model.Payments.OrderBy(p => p.CreatedAt))
        {
            var isReversal = p.Amount < 0;
            var isReversed = reversedIds.Contains(p.Id);
            <li class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2 @(isReversal ? "list-group-item-warning" : "")">
                <span class="@(isReversed ? "text-decoration-line-through text-muted" : "")">
                    @p.Method.Label() — @p.ReceivedByUserName — @p.CreatedAt.ToString("HH:mm")
                    @if (!string.IsNullOrEmpty(p.Note))
                    {
                        <span class="small text-muted d-block">@p.Note</span>
                    }
                </span>
                <span class="d-flex align-items-center gap-2">
                    @if (isReversed)
                    {
                        <span class="badge bg-secondary">İptal edildi</span>
                    }
                    <strong class="@(isReversed ? "text-decoration-line-through text-muted" : "")">@p.Amount.ToString("0.00") ₺</strong>
                    @if (canOperateCash && !Model.IsClosed && !isReversal && !isReversed)
                    {
                        if (pendingVoids.Any(v => v.PaymentId == p.Id))
                        {
                            <span class="badge bg-warning text-dark">İptal onayı bekliyor</span>
                        }
                        else
                        {
                            <details class="d-inline-block d-print-none">
                                <summary class="btn btn-sm btn-outline-danger">İptal talebi</summary>
                                <form asp-action="RequestPaymentVoid" asp-route-paymentId="@p.Id" method="post" class="mt-2 d-flex gap-1">
                                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="Gerekçe (ör. yanlış tutar)" maxlength="300" required />
                                    <button type="submit" class="btn btn-sm btn-danger">Gönder</button>
                                </form>
                            </details>
                        }
                    }
                </span>
            </li>
        }
    </ul>
}

@if (Model.Status == AdisyonStatus.Odendi && canOperateCash)
{
    if (pendingVoids.Any(v => v.Type == VoidRequestType.Iade))
    {
        <div class="alert alert-warning small">Bu hesap için iade talebi yönetici onayı bekliyor.</div>
    }
    else
    {
        <details class="mb-4 d-print-none">
            <summary class="btn btn-outline-danger">İade talebi</summary>
            <form asp-action="RequestRefund" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end mt-2">
                <div class="col-auto">
                    <label class="form-label small">Tutar (₺)</label>
                    <input type="number" step="0.01" min="0.01" max="@VoidRules.MaxRefund(Model).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" name="amount" class="form-control" value="@VoidRules.MaxRefund(Model).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" required />
                </div>
                <div class="col-auto">
                    <label class="form-label small">Yöntem</label>
                    <select name="method" class="form-select">
                        @foreach (var m in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@m">@m.Label()</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small">Gerekçe</label>
                    <input type="text" name="reason" class="form-control" maxlength="300" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-danger">Talep Gönder</button>
                </div>
            </form>
        </details>
    }
}

@if (Model.Status != AdisyonStatus.Odendi && Model.Status != AdisyonStatus.Iptal && Model.Status != AdisyonStatus.Iade)
{
    @if (!shiftOpen)
    {
        <div class="alert alert-danger">Ödeme alabilmek için önce kasa vardiyasını açmanız gerekiyor.</div>
    }
    else if (User.HasClaim(Permissions.ClaimType, Permissions.Cash.Operate))
    {
        <h6>Ödeme Al</h6>
        <form asp-action="AddPayment" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end mb-4">
            <div class="col-auto">
                <label class="form-label small">Yöntem</label>
                <select name="method" class="form-select">
                    @foreach (var m in Enum.GetValues<PaymentMethod>())
                    {
                        <option value="@m">@m.Label()</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small">Tutar (₺)</label>
                <input type="number" step="0.01" min="0" name="amount" class="form-control" value="@Model.RemainingTotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
            </div>
            @if (ViewBag.CardOnDevice == true)
            {
                <div class="col-auto">
                    <div class="form-check mb-2" title="Kartla ödemede tutar yazar kasa POS'una gönderilir; onay gelmezse ödeme kaydedilmez.">
                        <input class="form-check-input" type="checkbox" name="posCharge" value="true" id="posCharge" checked />
                        <label class="form-check-label small" for="posCharge">Kartı POS'tan çek</label>
                    </div>
                </div>
            }
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Ödeme Ekle</button>
            </div>
        </form>
    }

    @if (User.HasClaim(Permissions.ClaimType, Permissions.Cash.ApprovePayment))
    {
        <form asp-action="ConfirmPayment" asp-route-id="@Model.Id" method="post" class="row g-2 align-items-end"
              data-confirm="Ödeme onaylanacak ve adisyon kapatılacak." data-confirm-title="Ödeme onaylansın mı?" data-confirm-ok="Ödemeyi Onayla">
            <div class="col-auto">
                <label class="form-label small">Müşteri Telefonu (isteğe bağlı - sadakat puanı için)</label>
                <input type="text" name="customerPhone" class="form-control" placeholder="05xx xxx xx xx" value="@Model.Package?.CustomerPhone" />
            </div>
            <div class="col-auto">
                <label class="form-label small">Müşteri Adı (isteğe bağlı)</label>
                <input type="text" name="customerName" class="form-control" value="@Model.Package?.CustomerName" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-success" @(Model.RemainingTotal > 0 ? "disabled" : "")>
                    Ödemeyi Onayla / Masayı Kapat
                </button>
            </div>
        </form>
        @if (Model.RemainingTotal > 0)
        {
            <p class="text-muted small mt-2">Kalan tutar tamamen tahsil edilmeden adisyon kapatılamaz.</p>
        }
    }
}

@{
    var splitLines = ViewBag.SplitLines as IReadOnlyList<RestoranYonetim.Services.SplitLine> ?? Array.Empty<RestoranYonetim.Services.SplitLine>();
    var splitOpen = splitLines.Where(l => l.Remaining > 0).ToList();
    var splitRatio = Model.ItemsTotal > 0 ? Model.GrandTotal / Model.ItemsTotal : 0;
    var canSplit = !Model.IsClosed && shiftOpen && User.HasClaim(Permissions.ClaimType, Permissions.Cash.Operate) && Model.RemainingTotal > 0 && splitOpen.Count > 0;
}
<div class="row g-3 my-4">
    @if (canSplit)
    {
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-body">
                    <h6>Hesabı Böl (Ürün Bazlı)</h6>
                    <p class="text-muted small mb-2">Müşterinin ödeyeceği ürünlerin adedini seçin; tutar adisyon indirimine oranla hesaplanır. Ödenen ürünler bir sonraki kişide görünmez.</p>
                    <form asp-action="AddPayment" asp-route-id="@Model.Id" method="post" id="rySplitForm"
                          data-ratio="@splitRatio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          data-remaining="@Model.RemainingTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                        <input type="hidden" name="amount" value="0" />
                        <table class="table table-sm align-middle mb-2">
                            <thead><tr><th>Ürün</th><th class="text-end">Birim</th><th class="text-center">Kalan</th><th style="width:110px">Öde</th></tr></thead>
                            <tbody>
                            @foreach (var line in splitOpen)
                            {
                                <tr>
                                    <td>@line.Name</td>
                                    <td class="text-end">@line.UnitTotal.ToString("0.00") ₺</td>
                                    <td class="text-center">@line.Remaining</td>
                                    <td>
                                        <select class="form-select form-select-sm" name="items[@line.OrderItemId]" data-unit="@line.UnitTotal.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-remaining="@line.Remaining">
                                            @for (var q = 0; q <= line.Remaining; q++)
                                            {
                                                <option value="@q">@q</option>
                                            }
                                        </select>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <div class="d-flex flex-wrap gap-2 align-items-end">
                            <div>
                                <label class="form-label small mb-1">Yöntem</label>
                                <select name="method" class="form-select form-select-sm">
                                    @foreach (var m in Enum.GetValues<PaymentMethod>())
                                    {
                                        <option value="@m">@m.Label()</option>
                                    }
                                </select>
                            </div>
                            <div class="ms-auto text-end">
                                <div class="small text-muted">Ödenecek</div>
                                <strong class="fs-5" id="rySplitTotal">0,00 ₺</strong>
                            </div>
                            <button type="submit" class="btn btn-outline-primary" id="rySplitSubmit" disabled>Seçilenleri Öde</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h6>Hesabı Böl (Eşit)</h6>
                <p class="text-muted small mb-2">Kişi sayısını girin, kişi başı düşen tutarı görün.</p>
                <div class="input-group">
                    <span class="input-group-text">Kişi Sayısı</span>
                    <input type="number" min="1" value="2" id="splitCount" class="form-control" />
                </div>
                <p class="mt-2 mb-0">Kişi Başı: <strong id="splitResult">@((Model.RemainingTotal / 2).ToString("0.00")) ₺</strong></p>
            </div>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn btn-outline-secondary mt-3">← Kasaya Dön</a>
<button type="button" class="btn btn-outline-dark mt-3" data-print-url="@Url.Action("Yazdir", "Kasa", new { id = Model.Id })">🖨 Yazdır</button> <a class="btn btn-link btn-sm" href="@Url.Action("Yazdir", "Kasa", new { id = Model.Id })?onizleme=1" target="_blank" rel="noopener">Önizle</a>
@if (ViewBag.TransferPanel is TransferPanel transferPanel)
{
    <div class="mt-3"><partial name="_TableTransfer" model="transferPanel" /></div>
}


@section Scripts {
    <script>
        (function () {
            var remainingTotal = @Model.RemainingTotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var countInput = document.getElementById('splitCount');
            var result = document.getElementById('splitResult');
            function recalc() {
                var n = parseInt(countInput.value, 10) || 1;
                if (n < 1) { n = 1; }
                result.textContent = (remainingTotal / n).toFixed(2) + ' ₺';
            }
            countInput.addEventListener('input', recalc);

            var form = document.getElementById('rySplitForm');
            if (form) {
                var ratio = parseFloat(form.dataset.ratio);
                var remaining = parseFloat(form.dataset.remaining);
                var selects = Array.prototype.slice.call(form.querySelectorAll('select[data-unit]'));
                var total = document.getElementById('rySplitTotal');
                var submit = document.getElementById('rySplitSubmit');
                var update = function () {
                    var subtotal = 0, all = true, any = false;
                    selects.forEach(function (sel) {
                        var q = parseInt(sel.value, 10) || 0;
                        subtotal += q * parseFloat(sel.dataset.unit);
                        if (q > 0) { any = true; }
                        if (q !== parseInt(sel.dataset.remaining, 10)) { all = false; }
                    });
                    var amount = all ? remaining : Math.min(remaining, Math.round(subtotal * ratio * 100) / 100);
                    total.textContent = (any ? amount : 0).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' ₺';
                    submit.disabled = !any;
                };
                selects.forEach(function (sel) { sel.addEventListener('change', update); });
            }
        })();
    </script>
}
