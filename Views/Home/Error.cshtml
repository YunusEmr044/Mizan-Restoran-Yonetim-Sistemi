@{
    ViewData["Title"] = "Hata";
    Layout = "_PublicLayout";
    int? statusCode = ViewBag.StatusCode;
    string title = statusCode switch
    {
        404 => "Sayfa bulunamadı",
        403 => "Bu sayfaya erişim izniniz yok",
        401 => "Giriş yapmanız gerekiyor",
        _ => "Bir hata oluştu"
    };
    string message = statusCode switch
    {
        404 => "Aradığınız sayfa taşınmış veya kaldırılmış olabilir.",
        403 => "Bu işlem için yetkiniz bulunmuyor.",
        401 => "Devam etmek için lütfen giriş yapın.",
        _ => "Lütfen daha sonra tekrar deneyin."
    };
}
<div class="py-section text-center">
    <div class="container" style="max-width: 480px;">
        <div class="mx-auto mb-4" style="width:80px;height:80px;font-size:2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--py-gold-light),var(--py-gold));color:#241a0c;">
            <i class="bi bi-exclamation-triangle"></i>
        </div>
        <h2 class="py-serif fw-bold mb-3">@title</h2>
        <p class="text-muted">@message</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-py-dark mt-2"><i class="bi bi-house-door me-2"></i>Ana Sayfaya Dön</a>
    </div>
</div>
