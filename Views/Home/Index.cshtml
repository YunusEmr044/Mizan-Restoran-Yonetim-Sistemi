@using RestoranYonetim.Services
@model SiteContent
@{
    ViewData["Title"] = "Ana Sayfa";
    Layout = "_PublicLayout";

    // Bölümler HomeSection tablosundaki sıraya göre render edilir (bkz. HomePageController.Sections). Footer bu listede yok, her zaman gösterilir.
    var sectionOrder = (List<string>)(ViewBag.SectionOrder ?? new List<string>());
    var gallery = (List<GalleryImage>)ViewBag.GalleryPreview;
    var campaigns = (List<Campaign>)ViewBag.ActiveCampaigns;
    var testimonials = (List<Feedback>)ViewBag.Testimonials;
    var heroSlides = (List<HeroSlide>)ViewBag.HeroSlides;
    var stats = (List<HomeStat>)ViewBag.Stats;
    var features = (List<HomeFeature>)ViewBag.Features;
    var featuredMenu = (List<MenuItem>)ViewBag.FeaturedMenu;
    var chefSpecial = (ChefSpecial?)ViewBag.ChefSpecial;
    var workingHoursDays = (List<WorkingHoursDay>)ViewBag.WorkingHoursDays;
    var hoursStatus = (WorkingHoursStatus.Result)ViewBag.WorkingHoursStatus;

    // HeroSlide yoksa (yeni kurulum) SiteContent'in eski tekil Hero* alanlarından tek bir slayt üretilir.
    var effectiveSlides = heroSlides.Any()
        ? heroSlides
        : new List<HeroSlide>
        {
            new HeroSlide
            {
                Title = Model.HeroTitle,
                Subtitle = Model.HeroSubtitle,
                ImageUrl = Model.HeroImageUrl,
                PrimaryButtonText = Model.HeroPrimaryButtonText,
                PrimaryButtonUrl = Model.HeroPrimaryButtonUrl,
                SecondaryButtonText = Model.HeroSecondaryButtonText,
                SecondaryButtonUrl = Model.HeroSecondaryButtonUrl
            }
        };

    string Fallback(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;

    string AboutTeaser()
    {
        if (string.IsNullOrWhiteSpace(Model.AboutText)) { return "Yıllardır aynı özen ve tutkuyla, her tabakta unutulmaz bir deneyim sunuyoruz."; }
        var text = Model.AboutText.Trim();
        return text.Length > 240 ? text.Substring(0, 240).TrimEnd() + "…" : text;
    }
}
<style>
    /* ================= HERO (çok slaytlı) ================= */
    .py-hero {
        position: relative; min-height: 100vh; display: flex; align-items: center; overflow: hidden; background: var(--py-bg);
    }
    /* iOS Safari'de adres çubuğu açılıp kapandıkça 100vh zıplar; desteklenen tarayıcılarda daha kararlı olan svh'ye geçiyoruz. */
    @@supports (min-height: 100svh) {
        .py-hero { min-height: 100svh; }
    }
    .py-hero-slide {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
        opacity: 0; visibility: hidden;
        transition: opacity 1.1s ease;
        display: flex; align-items: center;
        z-index: 1;
    }
    /* ÖNEMLİ: aktif slayda position:relative verilmemeli - inset:0 relative'de boyut değil kayma etkisi yapar, hero küçülüp içerik kadar bir kutuya döner. Geçiş sadece opacity/visibility ile yapılmalı. */
    .py-hero-slide.py-hero-active { opacity: 1; visibility: visible; z-index: 2; }
    .py-hero-slide-img {
        position: absolute; inset: 0;
        background-size: cover; background-position: center;
        animation: pyKenBurns 22s ease-in-out infinite alternate;
    }
    @@keyframes pyKenBurns { 0% { transform: scale(1); } 100% { transform: scale(1.12); } }
    .py-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(var(--py-bg-rgb),.55) 0%, rgba(var(--py-bg-rgb),.78) 60%, rgba(var(--py-bg-rgb),.95) 100%); }
    .py-hero-content { position: relative; z-index: 2; color: #fff; }
    .py-hero .py-eyebrow { color: var(--py-gold-light); }
    .py-hero h1 { font-size: clamp(2.4rem, 5.5vw, 4.2rem); font-weight: 800; line-height: 1.08; text-shadow: 0 10px 40px rgba(0,0,0,.35); }
    .py-hero p.lead { color: #e9e1d3; font-weight: 300; max-width: 620px; }
    .py-hero-dots { position: absolute; z-index: 3; left: 50%; bottom: 4.6rem; transform: translateX(-50%); display: flex; gap: .5rem; }
    .py-hero-dot { width: 9px; height: 9px; border-radius: 50%; background: rgba(255,255,255,.4); border: none; padding: 0; transition: all .25s ease; cursor: pointer; }
    .py-hero-dot.py-hero-dot-active { background: var(--py-gold-light); width: 26px; border-radius: 5px; }
    .py-scroll-cue { position: absolute; bottom: 1.8rem; left: 50%; transform: translateX(-50%); z-index: 2; color: var(--py-gold-light); opacity: .85; animation: pyBounce 2.2s ease-in-out infinite; font-size: 1.4rem; }
    @@keyframes pyBounce { 0%, 100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 10px); } }

    /* ================= USP / Features ================= */
    .py-usp-card { background: #fff; border-radius: var(--py-radius); padding: 2.2rem 1.6rem; text-align: center; box-shadow: 0 20px 45px -25px rgba(30,20,10,.25); border: 1px solid rgba(var(--py-gold-rgb),.12); transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s ease; height: 100%; }
    .py-usp-card:hover { transform: translateY(-10px); box-shadow: 0 30px 55px -25px rgba(var(--py-gold-rgb),.4); }
    .py-usp-icon { width: 70px; height: 70px; margin: 0 auto 1.1rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--py-gold-light), var(--py-gold)); color: #241a0c; font-size: 1.7rem; box-shadow: 0 10px 25px -8px rgba(var(--py-gold-rgb),.6); }

    /* ================= Stats şeridi ================= */
    .py-stats-strip { background: var(--py-bg); color: #fff; padding: 3rem 0; position: relative; overflow: hidden; }
    .py-stats-strip::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 15% 30%, rgba(var(--py-gold-rgb),.18), transparent 45%), radial-gradient(circle at 85% 70%, rgba(var(--py-gold-rgb),.14), transparent 45%); }
    .py-stat-item { position: relative; text-align: center; }
    .py-stat-icon { font-size: 1.5rem; color: var(--py-gold-light); margin-bottom: .5rem; }
    .py-stat-value { font-family: var(--py-heading-font); font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; color: var(--py-gold-light); line-height: 1; }
    .py-stat-label { font-size: .85rem; color: #d8cfbf; margin-top: .4rem; letter-spacing: .02em; }

    /* ================= Öne çıkan lezzetler ================= */
    .py-highlight-strip { display: flex; gap: 1.1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: .5rem; scrollbar-width: thin; }
    .py-highlight-card { scroll-snap-align: start; flex: 0 0 220px; background: #fff; border-radius: 16px; overflow: hidden; border: 1px solid rgba(0,0,0,.05); box-shadow: 0 14px 32px -22px rgba(30,20,10,.35); transition: transform .3s cubic-bezier(.2,.8,.2,1), box-shadow .3s ease; }
    .py-highlight-card:hover { transform: translateY(-6px); box-shadow: 0 22px 42px -22px rgba(var(--py-gold-rgb),.45); }
    .py-highlight-img { height: 140px; overflow: hidden; }
    .py-highlight-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .py-highlight-card:hover .py-highlight-img img { transform: scale(1.08); }
    .py-highlight-body { padding: .9rem 1rem 1.1rem; }
    .py-highlight-price { color: var(--py-gold); font-weight: 700; font-size: .9rem; }

    /* ================= Hikâyemiz (about frame) ================= */
    .py-about-frame { position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 30px 60px -25px rgba(30,20,10,.4); }
    .py-about-frame::before { content: ""; position: absolute; inset: -14px auto auto -14px; width: 90px; height: 90px; border-top: 4px solid var(--py-gold); border-left: 4px solid var(--py-gold); border-radius: 20px 0 0 0; z-index: 2; }
    .py-about-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* ================= Şefin Önerisi ================= */
    .py-chef-card { background: var(--py-bg); border-radius: var(--py-radius); overflow: hidden; display: grid; grid-template-columns: 1fr; box-shadow: 0 30px 60px -30px rgba(0,0,0,.5); }
    @@media (min-width: 768px) { .py-chef-card { grid-template-columns: 1fr 1fr; } }
    .py-chef-img { height: 260px; overflow: hidden; }
    @@media (min-width: 768px) { .py-chef-img { height: 100%; } }
    .py-chef-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
    .py-chef-card:hover .py-chef-img img { transform: scale(1.06); }
    .py-chef-body { padding: 2.4rem 2rem; color: #fff; display: flex; flex-direction: column; justify-content: center; }
    .py-chef-price { font-family: var(--py-heading-font); font-size: 1.5rem; font-weight: 800; color: var(--py-gold-light); }

    /* ================= Kampanyalar (büyük + küçük) ================= */
    .py-campaign-big { position: relative; border-radius: var(--py-radius); min-height: 420px; background-size: cover; background-position: center; background-color: var(--py-bg-soft); display: flex; align-items: flex-end; overflow: hidden; box-shadow: 0 25px 50px -28px rgba(0,0,0,.45); }
    .py-campaign-big-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(var(--py-bg-rgb),.2) 0%, rgba(var(--py-bg-rgb),.92) 90%); }
    .py-campaign-big-body { position: relative; z-index: 2; padding: 2rem; color: #fff; display: flex; flex-direction: column; }
    .py-campaign-small { background: #fff; border-radius: 14px; padding: 1rem; display: flex; align-items: center; gap: 1rem; border: 1px solid rgba(0,0,0,.05); box-shadow: 0 12px 28px -22px rgba(30,20,10,.3); transition: transform .3s ease; flex: 1; }
    .py-campaign-small:hover { transform: translateX(4px); }
    .py-campaign-small img { width: 62px; height: 62px; border-radius: 10px; object-fit: cover; flex: none; }
    .py-campaign-small-icon { width: 62px; height: 62px; border-radius: 10px; flex: none; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--py-gold-light), var(--py-gold)); color: #241a0c; font-size: 1.3rem; }

    /* ================= Galeri (bento) ================= */
    .py-bento-grid { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: 130px; gap: .75rem; }
    @@media (max-width: 767px) { .py-bento-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 110px; } }
    .py-gallery-tile { border-radius: 14px; overflow: hidden; position: relative; }
    .py-gallery-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
    .py-gallery-tile:hover img { transform: scale(1.12); }
    .py-bento-big { grid-column: span 2; grid-row: span 2; }

    /* ================= QR / Dijital Menü Deneyimi ================= */
    .py-qr-section { display: grid; grid-template-columns: 1.05fr .95fr; gap: 3rem; align-items: center; }
    @@media (max-width: 991px) { .py-qr-section { grid-template-columns: 1fr; gap: 2.5rem; text-align: center; } }
    .py-qr-steps { margin-top: 1.8rem; display: flex; flex-direction: column; gap: 1.3rem; }
    @@media (max-width: 991px) { .py-qr-steps { text-align: start; } }
    .py-qr-step { display: flex; gap: 1.1rem; align-items: flex-start; }
    .py-qr-step-num { font-family: var(--py-heading-font); font-size: 1.6rem; font-weight: 800; color: var(--py-gold); opacity: .5; line-height: 1; flex: none; width: 2.4rem; }
    .py-qr-step-title { font-weight: 700; color: var(--py-text); margin-bottom: .15rem; }
    .py-qr-step-text { color: #6b5f4e; font-size: .92rem; margin: 0; }
    .py-qr-phone-wrap { display: flex; justify-content: center; }
    .py-qr-phone { position: relative; width: 230px; height: 470px; border-radius: 38px; background: linear-gradient(160deg, #241a0c, #0e0a06); padding: 12px; box-shadow: 0 35px 70px -30px rgba(30,20,10,.5), 0 0 0 2px rgba(var(--py-gold-rgb),.22); }
    .py-qr-phone::before { content: ""; position: absolute; top: 12px; left: 50%; transform: translateX(-50%); width: 84px; height: 20px; background: #0e0a06; border-radius: 0 0 14px 14px; z-index: 2; }
    .py-qr-phone-screen { position: relative; width: 100%; height: 100%; border-radius: 26px; overflow: hidden; background: linear-gradient(160deg, var(--py-bg-soft), var(--py-bg)); display: flex; align-items: center; justify-content: center; }
    .py-qr-phone-screen img { width: 100%; height: 100%; object-fit: cover; }
    .py-qr-phone-placeholder { text-align: center; color: #d8cfbf; padding: 1.5rem; }
    .py-qr-phone-placeholder i { font-size: 2.1rem; color: var(--py-gold-light); margin-bottom: .6rem; display: block; }
    .py-qr-phone-placeholder span { font-size: .82rem; }
    .py-qr-phone-mock { width: 100%; height: 100%; display: flex; flex-direction: column; color: #f3ead9; }
    .py-qr-phone-mock-bar { display: flex; justify-content: space-between; align-items: center; padding: .55rem .9rem .3rem; font-size: .68rem; font-weight: 600; color: #d8cfbf; }
    .py-qr-phone-mock-bar i { font-size: .65rem; margin-left: .25rem; }
    .py-qr-phone-mock-header { display: flex; align-items: center; justify-content: space-between; padding: .3rem 1rem .9rem; border-bottom: 1px solid rgba(var(--py-gold-rgb),.18); }
    .py-qr-phone-mock-title { font-family: var(--py-heading-font); font-weight: 700; font-size: 1.05rem; color: #fff; }
    .py-qr-phone-mock-header i { color: var(--py-gold-light); font-size: .95rem; }
    .py-qr-phone-mock-list { flex: 1; padding: .8rem .9rem; display: flex; flex-direction: column; gap: .65rem; }
    .py-qr-phone-mock-item { display: flex; align-items: center; gap: .6rem; background: rgba(255,255,255,.04); border: 1px solid rgba(var(--py-gold-rgb),.14); border-radius: 12px; padding: .55rem .7rem; }
    .py-qr-phone-mock-item-dot { width: 34px; height: 34px; flex: none; border-radius: 9px; background: linear-gradient(150deg, var(--py-gold-light), var(--py-gold)); display: flex; align-items: center; justify-content: center; color: #241a0c; font-size: .85rem; }
    .py-qr-phone-mock-item-info { flex: 1; min-width: 0; }
    .py-qr-phone-mock-item-name { font-size: .78rem; font-weight: 600; color: #f3ead9; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .py-qr-phone-mock-item-price { font-size: .78rem; font-weight: 700; color: var(--py-gold-light); flex: none; }
    .py-qr-phone-mock-item-skeleton { height: 34px; background: linear-gradient(90deg, rgba(255,255,255,.05), rgba(255,255,255,.1), rgba(255,255,255,.05)); background-size: 200% 100%; animation: pyPhoneSkeleton 1.8s ease-in-out infinite; border-style: dashed; }
    @@keyframes pyPhoneSkeleton { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    .py-qr-phone-mock-cta { margin: .2rem .9rem .9rem; text-align: center; background: linear-gradient(135deg, var(--py-gold-light), var(--py-gold)); color: #241a0c; font-weight: 700; font-size: .78rem; border-radius: 10px; padding: .55rem; }

    /* ================= Rezervasyon çağrısı ================= */
    .py-reservation-cta { position: relative; padding: 5rem 0; background-size: cover; background-position: center; background-color: var(--py-bg-soft); }
    .py-reservation-scrim { position: absolute; inset: 0; background: linear-gradient(135deg, rgba(var(--py-bg-rgb),.88), rgba(var(--py-bg-rgb),.75)); }

    /* ================= Konum / açık-kapalı rozeti ================= */
    .py-open-badge { display: inline-flex; align-items: center; gap: .5rem; padding: .5rem 1rem; border-radius: 999px; font-weight: 600; font-size: .9rem; }
    .py-open-dot { width: 9px; height: 9px; border-radius: 50%; }
    .py-open-yes { background: rgba(40,167,69,.12); color: #1e7e34; }
    .py-open-yes .py-open-dot { background: #28a745; animation: pyDotPulse 1.8s ease-in-out infinite; }
    .py-open-no { background: rgba(220,53,69,.1); color: #b02a37; }
    .py-open-no .py-open-dot { background: #dc3545; }
    @@keyframes pyDotPulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(40,167,69,.5); } 50% { box-shadow: 0 0 0 6px rgba(40,167,69,0); } }
    .py-map-frame { border-radius: var(--py-radius); overflow: hidden; box-shadow: 0 30px 60px -25px rgba(30,20,10,.4); aspect-ratio: 4/3; }
    .py-map-frame iframe { width: 100%; height: 100%; border: 0; }

    /* ================= Instagram ================= */
    .py-insta-tile { position: relative; border-radius: 10px; overflow: hidden; aspect-ratio: 1/1; }
    .py-insta-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .py-insta-overlay { position: absolute; inset: 0; background: rgba(var(--py-bg-rgb),.45); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1.4rem; opacity: 0; transition: opacity .3s ease; }
    .py-insta-tile:hover img { transform: scale(1.1); }
    .py-insta-tile:hover .py-insta-overlay { opacity: 1; }

    /* ================= Mobil inceliği ================= */
    @@media (max-width: 767px) {
        .py-hero-dots { bottom: 2.4rem; }
        .py-stats-strip { padding: 2rem 0; }
        .py-stat-value { font-size: 1.5rem; }
        .py-chef-body { padding: 1.6rem 1.3rem; }
        .py-campaign-big { min-height: 320px; }
        .py-reservation-cta { padding: 3rem 0; }
        .py-highlight-card { flex-basis: 170px; }
        .py-highlight-img { height: 110px; }
    }
</style>

@* Not: Hero admin panelden sıralanamaz, her zaman en üstte kalır - sadece açık/kapalı durumu etkilidir. Diğer bölümler admin sırasına göre render edilir. *@
@if (sectionOrder.Contains(HomeSectionCatalog.Hero))
{
<section class="py-hero" id="pyHero">
    @for (var i = 0; i < effectiveSlides.Count; i++)
    {
        var slide = effectiveSlides[i];
        <div class="py-hero-slide @(i == 0 ? "py-hero-active" : "")" data-slide-index="@i">
            @if (!string.IsNullOrEmpty(slide.ImageUrl))
            {
                <div class="py-hero-slide-img" style="background-image:url('@slide.ImageUrl');"></div>
            }
            <div class="py-hero-scrim"></div>
            <div class="container py-hero-content text-center text-md-start">
                <div class="py-eyebrow justify-content-center justify-content-md-start">Hoş Geldiniz</div>
                <h1 class="mb-3 py-reveal py-in">@slide.Title</h1>
                @if (!string.IsNullOrEmpty(slide.Subtitle))
                {
                    <p class="lead mx-auto mx-md-0 py-reveal py-in py-delay-1">@slide.Subtitle</p>
                }
                @if (!string.IsNullOrEmpty(slide.Description))
                {
                    <p class="mx-auto mx-md-0 py-reveal py-in py-delay-1" style="color:#d8cfbf; max-width:560px;">@slide.Description</p>
                }
                <div class="d-flex flex-wrap gap-3 mt-4 justify-content-center justify-content-md-start py-reveal py-in py-delay-2">
                    @if (!string.IsNullOrWhiteSpace(slide.PrimaryButtonText))
                    {
                        <a href="@(string.IsNullOrWhiteSpace(slide.PrimaryButtonUrl) ? Url.Action("Menu") : slide.PrimaryButtonUrl)" class="btn btn-py-gold btn-lg"><i class="bi bi-journal-richtext me-2"></i>@slide.PrimaryButtonText</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(slide.SecondaryButtonText))
                    {
                        <a href="@(string.IsNullOrWhiteSpace(slide.SecondaryButtonUrl) ? Url.Action("Rezervasyon") : slide.SecondaryButtonUrl)" class="btn btn-py-outline btn-lg"><i class="bi bi-calendar-check me-2"></i>@slide.SecondaryButtonText</a>
                    }
                </div>
            </div>
        </div>
    }
    @if (effectiveSlides.Count > 1)
    {
        <div class="py-hero-dots">
            @for (var i = 0; i < effectiveSlides.Count; i++)
            {
                <button type="button" class="py-hero-dot @(i == 0 ? "py-hero-dot-active" : "")" data-dot-index="@i" aria-label="Slayt @(i + 1)"></button>
            }
        </div>
    }
    <div class="py-scroll-cue"><i class="bi bi-chevron-double-down"></i></div>
</section>
}

@foreach (var key in sectionOrder.Where(k => k != HomeSectionCatalog.Hero))
{
    @if (key == HomeSectionCatalog.Stats && stats.Any())
    {
        <section class="py-stats-strip">
            <div class="container">
                <div class="row g-4">
                    @foreach (var s in stats)
                    {
                        <div class="col-6 col-md-3 py-stat-item py-reveal">
                            @if (!string.IsNullOrEmpty(s.Icon))
                            {
                                <div class="py-stat-icon"><i class="bi @s.Icon"></i></div>
                            }
                            <div class="py-stat-value" data-count-value="@s.Value">@s.Value</div>
                            <div class="py-stat-label">@s.Label</div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (key == HomeSectionCatalog.Features && features.Any())
    {
        <section class="py-section py-section-alt">
            <div class="container">
                <div class="text-center mb-5 py-reveal">
                    <div class="py-eyebrow justify-content-center">Bizi Özel Kılan</div>
                    <h2 class="py-serif fw-bold">@Fallback(Model.FeaturesSectionTitle, "Neden Bizi Seçmelisiniz")</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.FeaturesSectionSubtitle))
                    {
                        <p class="text-muted mx-auto" style="max-width:560px;">@Model.FeaturesSectionSubtitle</p>
                    }
                </div>
                <div class="row g-4">
                    @for (var i = 0; i < features.Count; i++)
                    {
                        var f = features[i];
                        <div class="col-md-4 py-reveal @(i == 1 ? "py-delay-1" : i == 2 ? "py-delay-2" : "")">
                            <div class="py-usp-card">
                                <div class="py-usp-icon"><i class="bi @(string.IsNullOrEmpty(f.Icon) ? "bi-star-fill" : f.Icon)"></i></div>
                                <h5 class="py-serif fw-bold mb-2">@f.Title</h5>
                                @if (!string.IsNullOrEmpty(f.Description))
                                {
                                    <p class="text-muted small mb-0">@f.Description</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (key == HomeSectionCatalog.FeaturedMenu && featuredMenu.Any())
    {
        <section class="py-section">
            <div class="container">
                <div class="d-flex justify-content-between align-items-end mb-4 py-reveal flex-wrap gap-2">
                    <div>
                        <div class="py-eyebrow">Menüden</div>
                        <h2 class="py-serif fw-bold mb-0">@Fallback(Model.FeaturedMenuSectionTitle, "Öne Çıkan Lezzetler")</h2>
                        @if (!string.IsNullOrWhiteSpace(Model.FeaturedMenuSectionSubtitle))
                        {
                            <p class="text-muted small mb-0 mt-1">@Model.FeaturedMenuSectionSubtitle</p>
                        }
                    </div>
