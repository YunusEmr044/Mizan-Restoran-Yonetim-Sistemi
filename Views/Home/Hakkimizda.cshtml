@model SiteContent
@{
    ViewData["Title"] = "Hakkımızda";
    Layout = "_PublicLayout";
}
<style>
    .py-about-hero {
        background: linear-gradient(135deg, var(--py-bg-soft), var(--py-bg));
        color: #fff;
        padding: 4.5rem 0 3rem;
        text-align: center;
    }
    .py-about-frame {
        position: relative;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 30px 60px -25px rgba(30,20,10,.4);
    }
    .py-about-frame::before {
        content: "";
        position: absolute;
        inset: -14px auto auto -14px;
        width: 90px; height: 90px;
        border-top: 4px solid var(--py-gold);
        border-left: 4px solid var(--py-gold);
        border-radius: 20px 0 0 0;
        z-index: 2;
    }
    .py-about-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>

<div class="py-about-hero">
    <div class="container">
        <div class="py-eyebrow justify-content-center">Hikayemiz</div>
        <h1 class="py-serif fw-bold">@Model.AboutTitle</h1>
    </div>
</div>

<div class="py-section">
    <div class="container">
        <div class="row align-items-center g-5">
            @if (!string.IsNullOrEmpty(Model.AboutImageUrl))
            {
                <div class="col-lg-5 py-reveal">
                    <div class="py-about-frame">
                        <img src="@Model.AboutImageUrl" alt="@Model.AboutTitle" />
                    </div>
                </div>
            }
            <div class="col-lg py-reveal py-delay-1">
                <div class="py-eyebrow">Bizi Tanıyın</div>
                @if (!string.IsNullOrEmpty(Model.AboutText))
                {
                    <p class="fs-5" style="white-space: pre-line; color: #3a3025;">@Model.AboutText</p>
                }
                else
                {
                    <p class="text-muted">İçerik yakında eklenecek.</p>
                }
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Testimonials", (List<Feedback>)ViewBag.Testimonials)
