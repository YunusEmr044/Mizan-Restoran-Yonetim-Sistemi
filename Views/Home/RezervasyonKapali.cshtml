@{
    ViewData["Title"] = "Rezervasyon";
    Layout = "_PublicLayout";
}
<div class="py-section text-center">
    <div class="container" style="max-width: 480px;">
        <div class="py-usp-icon mx-auto mb-4" style="width:80px;height:80px;font-size:2rem;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg, var(--py-gold-light), var(--py-gold));color:#241a0c;">
            <i class="bi bi-telephone-forward"></i>
        </div>
        <h2 class="py-serif fw-bold mb-3">Rezervasyon</h2>
        <p class="text-muted">Şu anda online rezervasyon almıyoruz. Lütfen bizi telefonla arayın, sizi ağırlamaktan mutluluk duyarız.</p>
    </div>
</div>
