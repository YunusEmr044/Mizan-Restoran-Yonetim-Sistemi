@model RestaurantTable
@{
    ViewData["Title"] = "Yeni Masa";
}
<h2 class="mb-4">Yeni Masa</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="AreaId" class="form-label">Alan</label>
        <select asp-for="AreaId" class="form-select" asp-items="@(new SelectList(ViewBag.Areas, "Id", "Name"))">
            <option value="">-- Alan seçin --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Örn: Masa 7" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
