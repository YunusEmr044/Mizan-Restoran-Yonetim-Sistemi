@model List<ChefSpecial>
@{
    ViewData["Title"] = "Şefin Önerisi";
    ViewBag.SiteActive = "chefspecial";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Şefin Önerisi</h2>
        <p class="text-muted small mb-0">Belirli bir tarih aralığında ana sayfada öne çıkan ürün - tarih dışına çıkınca otomatik yayından kalkar.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Yeni Öneri</a>
</div>

@await Html.PartialAsync("_HomeLayoutSubNav")

<div class="table-responsive">
<table class="table align-middle">
    <thead><tr><th>Ürün</th><th>Başlık</th><th>Tarih Aralığı</th><th>Durum</th><th></th></tr></thead>
    <tbody>
    @foreach (var s in Model)
    {
        <tr>
            <td>@(s.MenuItem?.Name ?? "—")</td>
            <td>@s.EffectiveTitle</td>
            <td>@s.StartDate.ToString("dd.MM.yyyy") - @s.EndDate.ToString("dd.MM.yyyy")</td>
            <td>
                @if (s.IsCurrentlyRunning)
                {
                    <span class="badge bg-success">Şu an yayında</span>
                }
                else if (!s.IsActive)
                {
                    <span class="badge bg-secondary">Pasif</span>
                }
                else if (s.EndDate.Date < DateTime.Today)
                {
                    <span class="badge bg-secondary">Süresi doldu</span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">İleri tarihli</span>
                }
            </td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" data-confirm="Bu şefin önerisi kalıcı olarak silinecek." data-confirm-title="Silinsin mi?" data-confirm-ok="Sil" data-confirm-danger>
                    <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                </form>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-muted">Henüz şefin önerisi eklenmedi.</td></tr>
    }
    </tbody>
</table>
</div>
