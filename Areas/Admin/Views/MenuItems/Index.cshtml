@model List<MenuItem>
@{
    ViewData["Title"] = "Menü Ürünleri";
    ViewBag.MenuYonetimiActive = "menuitems";
    var categories = Model.Where(m => m.Category != null)
        .Select(m => m.Category!)
        .GroupBy(c => c.Id)
        .Select(g => g.First())
        .OrderBy(c => c.DisplayOrder)
        .ToList();
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Menü Ürünleri</h2>
        <p class="text-muted small mb-0">@Model.Count ürün, @categories.Count kategori</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">+ Yeni Ürün</a>
    </div>
</div>

@await Html.PartialAsync("_MenuYonetimiSubNav")

<div class="mb-3">
    <div class="ry-search-box">
        <i class="bi bi-search"></i>
        <input type="search" id="menuSearch" class="form-control" placeholder="Ürün veya kategori ara... (binlerce ürün arasında hızlıca bulun)" autocomplete="off" />
    </div>
</div>

<div class="ry-cat-chips mb-4" id="categoryChips">
    <button type="button" class="ry-cat-chip active" data-category="">Tümü <span class="ry-cat-chip-count">@Model.Count</span></button>
    @foreach (var c in categories)
    {
        var count = Model.Count(m => m.CategoryId == c.Id);
        <button type="button" class="ry-cat-chip" data-category="@c.Name.ToLowerInvariant()">@c.Name <span class="ry-cat-chip-count">@count</span></button>
    }
</div>

<div class="table-responsive">
    <table class="table align-middle" id="menuTable">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Kategori</th>
                <th>Fiyat</th>
                <th>Tahmini Maliyet</th>
                <th>Tahmini Kâr</th>
                <th>Durum</th>
                <th>Ana Sayfa</th>
                <th class="text-end">İşlemler</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr data-name="@m.Name.ToLowerInvariant()" data-category="@(m.Category?.Name.ToLowerInvariant() ?? "")">
                <td class="fw-semibold">@m.Name</td>
                <td><span class="badge bg-light text-dark border">@m.Category?.Name</span></td>
                <td>@m.Price.ToString("0.00") ₺</td>
                <td>
                    @if (m.RecipeItems.Any())
                    {
                        @($"{m.EstimatedCost:0.00} ₺")
                    }
                    else
                    {
                        <span class="text-muted small">Reçete yok</span>
                    }
                </td>
                <td>
                    @if (m.RecipeItems.Any())
                    {
                        <span class="@(m.EstimatedProfit >= 0 ? "text-success" : "text-danger") fw-semibold">@m.EstimatedProfit.ToString("0.00") ₺</span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }
                </td>
                <td>
                    @if (m.IsAvailable)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>
                    @if (m.IsFeaturedHome)
                    {
                        <span class="badge bg-warning text-dark" title="Ana sayfa sırası: @m.FeaturedOrder"><i class="bi bi-star-fill"></i> Öne çıkan</span>
                    }
                    else
                    {
                        <span class="text-muted small">—</span>
                    }
                </td>
                <td class="text-end">
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i> Düzenle</a>
                        <a asp-action="Options" asp-route-id="@m.Id" class="btn btn-outline-primary" title="Ekstra seçenekler"><i class="bi bi-sliders"></i> Seçenekler</a>
                        <a asp-action="Recipe" asp-route-id="@m.Id" class="btn btn-outline-dark" title="Reçete / maliyet"><i class="bi bi-clipboard-data"></i> Reçete</a>
                        <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
<p class="text-muted small" id="menuEmptyState" style="display:none;">Aramanızla eşleşen ürün bulunamadı.</p>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('menuSearch');
            var chips = document.querySelectorAll('#categoryChips .ry-cat-chip');
            var rows = document.querySelectorAll('#menuTable tbody tr');
            var emptyState = document.getElementById('menuEmptyState');
            var activeCategory = '';

            function applyFilter() {
                var q = (searchInput.value || '').trim().toLowerCase();
                var visibleCount = 0;
                rows.forEach(function (row) {
                    var name = row.getAttribute('data-name') || '';
                    var cat = row.getAttribute('data-category') || '';
                    var matchesCategory = !activeCategory || cat === activeCategory;
                    var matchesSearch = !q || name.indexOf(q) !== -1 || cat.indexOf(q) !== -1;
                    var visible = matchesCategory && matchesSearch;
                    row.style.display = visible ? '' : 'none';
                    if (visible) { visibleCount++; }
                });
                emptyState.style.display = visibleCount === 0 ? '' : 'none';
            }

            searchInput.addEventListener('input', applyFilter);
            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    chips.forEach(function (c) { c.classList.remove('active'); });
                    chip.classList.add('active');
                    activeCategory = chip.getAttribute('data-category') || '';
                    applyFilter();
                });
            });
        })();
    </script>
}
