@model IReadOnlyList<RestoranYonetim.Services.MenuCsvError>
@{
    ViewData["Title"] = "Menüyü Dosyadan Aktar";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Menüyü Dosyadan Aktar</h2>
        <p class="text-muted small mb-0">Çok sayıda ürünü tek seferde eklemek ya da fiyatları toplu güncellemek için.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">← Menü Ürünleri</a>
</div>

@if (Model.Any())
{
    <div class="alert alert-danger">
        <strong>Hiçbir ürün kaydedilmedi.</strong> Dosyadaki hataları düzeltip yeniden yükleyin:
        <ul class="mb-0 mt-2">
            @foreach (var e in Model.Take(50)) { <li>@e.Message</li> }
        </ul>
        @if (Model.Count > 50) { <div class="mt-1">… ve @(Model.Count - 50) hata daha.</div> }
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h6>1. Şablonu indirin ve doldurun</h6>
            <p class="small text-muted">Şablon Excel'de açılır. Her satır bir ürün; sütunlar:</p>
            <ul class="small">
                <li><strong>Kategori</strong> (zorunlu) — yoksa oluşturulur.</li>
                <li><strong>Ürün</strong> (zorunlu) — aynı kategoride aynı adlı ürün varsa güncellenir.</li>
                <li><strong>Fiyat</strong> (zorunlu) — ör. <code>125,50</code>.</li>
                <li><strong>Açıklama</strong> — ör. porsiyon: <code>250 g</code>.</li>
                <li><strong>Bölüm</strong> — <code>Mutfak</code> ya da <code>Bar</code>; boşsa Mutfak.</li>
                <li><strong>KDV</strong> — 0, 1, 10 ya da 20; boşsa kategorinin oranı.</li>
            </ul>
            <a asp-action="ImportTemplate" class="btn btn-outline-dark"><i class="bi bi-download me-1"></i>Şablonu indir (CSV)</a>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100"><div class="card-body">
            <h6>2. Dosyayı yükleyin</h6>
            <p class="small text-muted">Excel'de "Farklı Kaydet → CSV (noktalı virgülle ayrılmış)" seçin. Dosyada tek bir hatalı satır varsa hiçbir şey kaydedilmez; hatalar satır numarasıyla listelenir. Fotoğrafları sonradan ürün düzenleme ekranından ekleyebilirsiniz.</p>
            <form asp-action="Import" method="post" enctype="multipart/form-data" class="d-flex gap-2 flex-wrap">
                <input type="file" name="file" accept=".csv,text/csv" class="form-control" required style="max-width: 360px" />
                <button type="submit" class="btn btn-primary"><i class="bi bi-upload me-1"></i>Aktar</button>
            </form>
        </div></div>
    </div>
</div>
