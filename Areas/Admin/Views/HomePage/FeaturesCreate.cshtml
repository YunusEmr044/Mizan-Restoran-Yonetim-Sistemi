@model HomeFeature
@{
    ViewData["Title"] = "Yeni Özellik";
}
<h2 class="mb-4">Yeni Özellik</h2>
<form asp-action="FeaturesCreate" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Taze Malzemeler" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Her gün özenle seçilen kaliteli malzemeler."></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Icon" class="form-label"></label>
        <input asp-for="Icon" class="form-control" placeholder="bi-egg-fried" />
        <div class="form-text">Bootstrap Icons sınıf adı (opsiyonel) - <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener">simge listesi</a>.</div>
    </div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
        </div>
        <div class="col-md mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Features" class="btn btn-outline-secondary">Vazgeç</a>
</form>
