@model HeroSlide
@{
    ViewData["Title"] = "Hero Slaytını Düzenle";
}
<h2 class="mb-4">Hero Slaytını Düzenle</h2>
<form asp-action="HeroEdit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Subtitle" class="form-label"></label>
        <input asp-for="Subtitle" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
    <div class="row">
        <div class="col-md mb-3">
            <label class="form-label">Görsel (Masaüstü) - değiştirmek için yeni dosya seçin</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-2 d-flex align-items-center gap-3">
                    <img src="@Model.ImageUrl" style="max-height:90px;" class="rounded" alt="" />
                    <div class="form-check">
                        <input type="checkbox" name="removeImage" value="true" class="form-check-input" id="removeImage" />
                        <label class="form-check-label" for="removeImage">Görseli kaldır</label>
                    </div>
                </div>
            }
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>
        <div class="col-md mb-3">
            <label class="form-label">Görsel (Mobil) - değiştirmek için yeni dosya seçin</label>
            @if (!string.IsNullOrEmpty(Model.MobileImageUrl))
            {
                <div class="mb-2 d-flex align-items-center gap-3">
                    <img src="@Model.MobileImageUrl" style="max-height:90px;" class="rounded" alt="" />
                    <div class="form-check">
                        <input type="checkbox" name="removeMobileImage" value="true" class="form-check-input" id="removeMobileImage" />
                        <label class="form-check-label" for="removeMobileImage">Görseli kaldır</label>
                    </div>
                </div>
            }
            <input type="file" name="mobileImageFile" class="form-control" accept="image/*" />
        </div>
    </div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="PrimaryButtonText" class="form-label"></label>
            <input asp-for="PrimaryButtonText" class="form-control" />
        </div>
        <div class="col-md mb-3">
            <label asp-for="PrimaryButtonUrl" class="form-label"></label>
            <input asp-for="PrimaryButtonUrl" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="SecondaryButtonText" class="form-label"></label>
            <input asp-for="SecondaryButtonText" class="form-control" />
        </div>
        <div class="col-md mb-3">
            <label asp-for="SecondaryButtonUrl" class="form-label"></label>
            <input asp-for="SecondaryButtonUrl" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
        </div>
        <div class="col-md mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Hero" class="btn btn-outline-secondary">Vazgeç</a>
</form>
