@model HomeStat
@{
    ViewData["Title"] = "Yeni İstatistik";
}
<h2 class="mb-4">Yeni İstatistik</h2>
<form asp-action="StatsCreate" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="Value" class="form-label"></label>
            <input asp-for="Value" class="form-control" placeholder="4.9 / 5" />
        </div>
        <div class="col-md mb-3">
            <label asp-for="Label" class="form-label"></label>
            <input asp-for="Label" class="form-control" placeholder="Müşteri Puanı" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Icon" class="form-label"></label>
        <input asp-for="Icon" class="form-control" placeholder="bi-star-fill" />
        <div class="form-text">Bootstrap Icons sınıf adı (opsiyonel) - <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener">simge listesi</a>.</div>
    </div>
    <div class="row">
        <div class="col-md mb-3">
            <label asp-for="DisplayOrder" class="form-label"></label>
            <input asp-for="DisplayOrder" class="form-control" />
        </div>
        <div class="col-md mb-3 d-flex align-items-end">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Stats" class="btn btn-outline-secondary">Vazgeç</a>
</form>
