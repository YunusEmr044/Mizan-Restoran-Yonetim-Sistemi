@model Branch
@{
    ViewData["Title"] = "Yeni Şube";
}
<h2 class="mb-4">Yeni Şube</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="RestaurantId" class="form-label">Restoran</label>
        <select asp-for="RestaurantId" class="form-select" asp-items="@(new SelectList(ViewBag.Restaurants, "Id", "Name"))">
            <option value="">-- Restoran seçin --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <input asp-for="Address" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
