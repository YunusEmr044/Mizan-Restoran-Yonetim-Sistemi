@model PageSeo
@{
    var pageDef = (SeoPageDefinition)ViewBag.PageDef;
    ViewData["Title"] = $"SEO - {pageDef.Label}";
    ViewBag.SiteActive = "seopages";
}
<h2 class="mb-1">@pageDef.Label - SEO</h2>
<p class="text-muted small mb-3">Yol: <code>@pageDef.Path</code>. Boş bırakılan alanlar için varsayılan: "@pageDef.DefaultTitle"@(string.IsNullOrWhiteSpace(pageDef.DefaultDescription) ? "" : $" / \"{pageDef.DefaultDescription}\"").</p>

@await Html.PartialAsync("_SeoSubNav")

<form asp-action="PageEdit" asp-route-key="@pageDef.Key" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="@pageDef.DefaultTitle" />
    </div>
    <div class="mb-3">
        <label asp-for="MetaDescription" class="form-label"></label>
        <textarea asp-for="MetaDescription" class="form-control" rows="2" placeholder="@pageDef.DefaultDescription"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="CanonicalUrl" class="form-label"></label>
        <input asp-for="CanonicalUrl" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3 d-flex align-items-center">
            <div class="form-check">
                <input asp-for="NoIndex" class="form-check-input" />
                <label asp-for="NoIndex" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-6 mb-3 d-flex align-items-center">
            <div class="form-check">
                <input asp-for="NoFollow" class="form-check-input" />
                <label asp-for="NoFollow" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <h5 class="mt-4">Open Graph (Sosyal Medya Paylaşımı)</h5>
    <div class="mb-3">
        <label asp-for="OgTitle" class="form-label"></label>
        <input asp-for="OgTitle" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="OgDescription" class="form-label"></label>
        <textarea asp-for="OgDescription" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label class="form-label">Open Graph Görseli</label>
        @if (!string.IsNullOrEmpty(Model.OgImageUrl))
        {
            <div class="mb-2 d-flex align-items-center gap-3">
                <img src="@Model.OgImageUrl" style="max-height:80px;" class="img-thumbnail" />
                <div class="form-check">
                    <input type="checkbox" name="removeOgImage" value="true" class="form-check-input" id="removeOgImage" />
                    <label class="form-check-label" for="removeOgImage">Görseli kaldır</label>
                </div>
            </div>
        }
        <input type="file" name="ogImage" class="form-control" accept="image/*" />
        <div class="form-text">Boş bırakılırsa site genelindeki (SEO Ayarları) varsayılan paylaşım görseli kullanılır.</div>
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Pages" class="btn btn-outline-secondary">Vazgeç</a>
</form>
