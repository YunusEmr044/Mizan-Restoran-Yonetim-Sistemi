@model RestoranYonetim.Areas.Admin.Controllers.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
@if (Model.PreviewBlocked)
{
    <div class="card"><div class="card-body text-center py-5">
        <i class="bi bi-eye-slash fs-1 text-muted"></i>
        <h5 class="mt-3">@RolePermissions.DisplayName(Model.PreviewRole!) bu sayfayı göremez.</h5>
        @if (Model.PreviewLanding != null)
        {
            <p class="text-muted">Bu rol giriş yapınca <a href="@Model.PreviewLanding">@Model.PreviewLanding</a> ekranına yönlenir.</p>
        }
        else
        {
            <p class="text-muted">Bu rol giriş yapınca menüsündeki ilk sayfaya yönlenir.</p>
        }
    </div></div>
    return;
}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="mb-1">Hoş geldiniz</h2>
        <p class="text-muted mb-0">İşletmenizin bugünkü durumuna genel bakış.</p>
    </div>
</div>
@if (Model.SetupSteps is { } setupSteps)
{
    var setupDone = setupSteps.Count(s => s.Done);
    <a asp-controller="Setup" asp-action="Index" class="d-block text-reset text-decoration-none mb-4">
        <div class="ry-kpi d-flex align-items-center gap-3" style="border-left: 4px solid var(--ry-accent, #cd9f56);">
            <i class="bi bi-rocket-takeoff fs-3"></i>
            <div class="flex-grow-1">
                <div class="ry-kpi-label">Kurulum</div>
                <div class="fw-semibold">@setupDone / @setupSteps.Count adım tamamlandı · Sıradaki: @setupSteps.First(s => !s.Done).Title</div>
            </div>
            <span class="small text-primary text-nowrap">Kuruluma devam et →</span>
        </div>
    </a>
}
<style>
    .dashboard-card-link { display:block; color:inherit; text-decoration:none; height:100%; }
    .dashboard-card-link:hover { color:inherit; }
    .dashboard-card-link .ry-kpi, .dashboard-card-link .card { transition:transform .2s ease, box-shadow .2s ease; height:100%; }
    .dashboard-card-link:hover .ry-kpi, .dashboard-card-link:hover .card { transform:translateY(-2px); box-shadow:0 10px 24px rgba(30,20,10,.12); }
</style>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <a asp-area="Admin" asp-controller="Reports" asp-action="Satis" class="dashboard-card-link">
        <div class="ry-kpi d-flex align-items-start justify-content-between">
            <div>
                <div class="ry-kpi-label">Bugünkü Ciro</div>
                <div class="ry-kpi-value">@Model.TodayRevenue.ToString("0.00") ₺</div>
            </div>
            <i class="bi bi-cash-stack"></i>
        </div>
        </a>
    </div>
    <div class="col-md-3 col-6">
        <a asp-area="Admin" asp-controller="Reports" asp-action="Urunler" class="dashboard-card-link">
        <div class="ry-kpi d-flex align-items-start justify-content-between">
            <div>
                <div class="ry-kpi-label">Bugünkü Sipariş</div>
                <div class="ry-kpi-value">@Model.TodayOrderCount</div>
            </div>
            <i class="bi bi-receipt-cutoff"></i>
        </div>
        </a>
    </div>
    <div class="col-md-3 col-6">
        <a href="@(Model.CanManageTables ? Url.Action("Index", "Tables", new { area = "Admin" }) : null)" class="@(Model.CanManageTables ? "dashboard-card-link" : "d-block h-100 text-reset")">
        <div class="ry-kpi d-flex align-items-start justify-content-between">
            <div>
                <div class="ry-kpi-label">Dolu Masa</div>
                <div class="ry-kpi-value">@Model.OpenTables</div>
            </div>
            <i class="bi bi-table"></i>
        </div>
        </a>
    </div>
    @if (Model.ShowCash)
    {
        <div class="col-md-3 col-6">
            <a asp-area="" asp-controller="Kasa" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi d-flex align-items-start justify-content-between">
                <div>
                    <div class="ry-kpi-label">Kasa Vardiyası</div>
                    <div class="ry-kpi-value @(Model.OpenShift != null ? "text-success" : "text-danger")" style="font-size:1.15rem;">
                        @(Model.OpenShift != null ? "Açık" : "Kapalı")
                    </div>
                </div>
                <i class="bi @(Model.OpenShift != null ? "bi-unlock" : "bi-lock")"></i>
            </div>
            </a>
        </div>
    }
</div>

<div class="row g-3 mb-4">
    @if (Model.PendingPayment is int pendingPayment)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="" asp-controller="Kasa" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #cd9f56;">
                <div class="ry-kpi-label">Ödeme Bekleyen Masa</div>
                <div class="ry-kpi-value">@pendingPayment</div>
                <span class="small text-primary">Kasaya git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.ActiveWaiterCalls is int waiterCalls)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="" asp-controller="Staff" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #0dcaf0;">
                <div class="ry-kpi-label">Aktif Garson Çağrısı</div>
                <div class="ry-kpi-value">@waiterCalls</div>
                <span class="small text-primary">Sipariş ekranına git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.PendingDiscounts is int pendingDiscounts)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="" asp-controller="Kasa" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #6c757d;">
                <div class="ry-kpi-label">Bekleyen İndirim Talebi</div>
                <div class="ry-kpi-value">@pendingDiscounts</div>
                <span class="small text-primary">Kasaya git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.OpenPackages is int openPackages)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="" asp-controller="Staff" asp-action="Paketler" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #6f42c1;">
                <div class="ry-kpi-label">Açık Paket</div>
                <div class="ry-kpi-value">@openPackages</div>
                <span class="small text-primary">Paketlere git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.PrintFailures is int printFailures)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="Admin" asp-controller="Printers" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #dc3545;">
                <div class="ry-kpi-label">Basılamayan Mutfak Fişi</div>
                <div class="ry-kpi-value text-danger">@printFailures</div>
                <span class="small text-primary">Yazıcılara git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.FiscalPending is int fiscalPending)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="" asp-controller="Kasa" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #fd7e14;">
                <div class="ry-kpi-label">Mali Fiş Bekleyen</div>
                <div class="ry-kpi-value">@fiscalPending</div>
                <span class="small text-primary">Kasaya git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.PendingLeaves is int pendingLeaves)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="Admin" asp-controller="Personnel" asp-action="Leaves" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #20c997;">
                <div class="ry-kpi-label">Bekleyen İzin Talebi</div>
                <div class="ry-kpi-value">@pendingLeaves</div>
                <span class="small text-primary">İzinlere git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.PendingVoids is int pendingVoids)
    {
        <div class="col-md-6 col-xl-3">
            <a asp-area="" asp-controller="Kasa" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #dc3545;">
                <div class="ry-kpi-label">Bekleyen İptal/İade Talebi</div>
                <div class="ry-kpi-value">@pendingVoids</div>
                <span class="small text-primary">Kasaya git →</span>
            </div>
            </a>
        </div>
    }
</div>

<div class="row g-3">
    @if (Model.TodayReservationCount is int reservationCount)
    {
        <div class="col-md-6">
            <a asp-area="Admin" asp-controller="Reservations" asp-action="Index" class="dashboard-card-link">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-white">
                    <span><i class="bi bi-calendar-check text-primary me-1"></i>Bugünkü Rezervasyonlar</span>
                    <span class="badge bg-primary">@reservationCount</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var r in Model.NextReservations)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@r.Time.ToString(@"hh\:mm") · @r.Name</span>
                            <span class="text-muted">@r.PartySize kişi</span>
                        </li>
                    }
                    @if (reservationCount == 0)
                    {
                        <li class="list-group-item text-muted">Bugün için rezervasyon yok.</li>
                    }
                </ul>
                <div class="card-footer bg-white"><span class="small text-primary">Rezervasyonlara git →</span></div>
            </div>
            </a>
        </div>
    }
    @if (Model.FeedbackCount is int feedbackCount)
    {
        <div class="col-md-6">
            <a asp-area="Admin" asp-controller="Feedback" asp-action="Index" class="dashboard-card-link">
            <div class="ry-kpi" style="border-left: 4px solid #ffc107;">
                <div class="ry-kpi-label">Son 7 Gün Geri Bildirim</div>
                <div class="ry-kpi-value">
                    @feedbackCount
                    @if (Model.FeedbackAverage is double avg)
                    {
                        <small class="text-muted fs-6 ms-2"><i class="bi bi-star-fill text-warning"></i> @avg.ToString("0.0")</small>
                    }
                </div>
                <span class="small text-primary">Geri bildirimlere git →</span>
            </div>
            </a>
        </div>
    }
    @if (Model.LowStockCount is int lowStockCount)
    {
        <div class="col-md-6">
            <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="dashboard-card-link">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center bg-white">
                    <span><i class="bi bi-exclamation-triangle text-warning me-1"></i>Kritik Stok Seviyesi</span>
                    <span class="badge bg-danger">@lowStockCount</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in Model.LowStockItems)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.Name</span>
                            <span class="text-danger">@item.CurrentQuantity.ToString("0.###") @item.Unit</span>
                        </li>
                    }
                    @if (lowStockCount == 0)
                    {
                        <li class="list-group-item text-muted">Kritik seviyede malzeme yok.</li>
                    }
                </ul>
                <div class="card-footer bg-white"><span class="small text-primary">Stok listesine git →</span></div>
            </div>
            </a>
        </div>
    }
    <div class="col-md-6">
        <a asp-area="Admin" asp-controller="Reports" asp-action="Urunler" class="dashboard-card-link">
        <div class="card">
            <div class="card-header bg-white"><i class="bi bi-trophy text-warning me-1"></i>Son 30 Günün En Çok Satan Ürünleri</div>
            <ul class="list-group list-group-flush">
                @foreach (var p in Model.TopProducts)
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@p.Name</span>
                        <span>@p.Quantity adet — @p.Revenue.ToString("0.00") ₺</span>
                    </li>
                }
                @if (Model.TopProducts.Count == 0)
                {
                    <li class="list-group-item text-muted">Henüz veri yok.</li>
                }
            </ul>
        </div>
        </a>
    </div>
</div>
