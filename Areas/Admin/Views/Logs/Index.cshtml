@model List<RestoranYonetim.Models.AuditLog>
@{
    ViewData["Title"] = "Loglar";
    string? selectedUserId = ViewBag.SelectedUserId;
    int totalCount = ViewBag.TotalCount;
    int pageNum = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    var users = ViewBag.Users;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Loglar</h2>
        <p class="text-muted small mb-0">@totalCount kayıt - sistemdeki kritik işlemlerin (kullanıcı/rol, ödeme, indirim, vardiya, stok, fiyat, tema vb.) denetim izi</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Export" asp-route-userId="@selectedUserId" class="btn btn-outline-secondary btn-sm"><i class="bi bi-download"></i> Dışa Aktar (CSV)</a>
        <a asp-action="Temizle" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Eski Kayıtları Temizle</a>
    </div>
</div>


<div class="mb-3">
    <form method="get" class="d-flex align-items-end gap-2 flex-wrap">
        <div>
            <label class="form-label small mb-1">Kullanıcı</label>
            <select name="userId" class="form-select" onchange="this.form.submit()">
                <option value="">— Genel (tüm kullanıcılar) —</option>
                @foreach (var u in users)
                {
                    <option value="@u.UserId" selected="@(u.UserId == selectedUserId)">@(string.IsNullOrWhiteSpace(u.UserName) ? u.UserId : u.UserName)</option>
                }
            </select>
        </div>
        @if (!string.IsNullOrWhiteSpace(selectedUserId))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Genel görünüme dön</a>
        }
    </form>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead><tr><th>Tarih</th><th>Kullanıcı</th><th>İşlem</th><th>Varlık</th><th>Detay</th></tr></thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td class="text-nowrap">@log.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                <td>@(log.UserName ?? "-")</td>
                <td class="fw-semibold">@log.Action</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(log.EntityName))
                    {
                        <span class="badge bg-dark">@log.EntityName@(string.IsNullOrWhiteSpace(log.EntityId) ? "" : $" #{log.EntityId}")</span>
                    }
                </td>
                <td class="text-muted small">@log.Details</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-muted">Kayıt bulunamadı.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Sayfalar" class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Sayfa @pageNum / @totalPages</span>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(pageNum <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(pageNum - 1)" asp-route-userId="@selectedUserId">&laquo; Önceki</a>
            <a class="btn btn-outline-secondary btn-sm @(pageNum >= totalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(pageNum + 1)" asp-route-userId="@selectedUserId">Sonraki &raquo;</a>
        </div>
    </nav>
}
