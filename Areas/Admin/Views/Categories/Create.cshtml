@model Category
@{
    ViewData["Title"] = "Yeni Kategori";
}
<h2 class="mb-4">Yeni Kategori</h2>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DisplayOrder" class="form-label"></label>
        <input asp-for="DisplayOrder" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="VatRate" class="form-label"></label>
        <select asp-for="VatRate" class="form-select" asp-items="@(new SelectList(RestoranYonetim.Services.Fiscal.VatRates.Allowed))"></select>
        <div class="form-text">Mali fişte bu kategorinin ürünleri bu oranla yazılır. Oranları mali müşavirinizle teyit edin.</div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
