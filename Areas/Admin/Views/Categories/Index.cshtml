@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
    ViewBag.MenuYonetimiActive = "categories";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Kategoriler</h2>
        <p class="text-muted small mb-0">@Model.Count kategori</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-primary">+ Yeni Kategori</a>
    </div>
</div>

@await Html.PartialAsync("_MenuYonetimiSubNav")

@if (!Model.Any())
{
    <p class="text-muted">Henüz kategori eklenmemiş.</p>
}

<div class="ry-cat-grid">
    @foreach (var c in Model)
    {
        <div class="ry-cat-card">
            <div class="ry-cat-card-icon"><i class="bi bi-tag-fill"></i></div>
            <div class="ry-cat-card-name">@c.Name</div>
            <div class="ry-cat-card-meta">@c.MenuItems.Count ürün · Sıra @c.DisplayOrder</div>
            <div class="ry-cat-card-actions">
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
            </div>
        </div>
    }
</div>
