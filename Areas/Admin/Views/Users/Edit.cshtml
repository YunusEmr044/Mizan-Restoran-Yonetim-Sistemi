@model UserEditViewModel
@{
    ViewData["Title"] = "Kullanıcı Düzenle";
}

<h2 class="mb-4">Kullanıcı Düzenle</h2>


<div asp-validation-summary="All" class="text-danger"></div>
<form method="post" class="mb-4">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="FullName" class="form-label">Ad Soyad</label>
        <input asp-for="FullName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label">E-posta</label>
        <input asp-for="Email" class="form-control" type="email" required />
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label">Rol</label>
        <select asp-for="Role" class="form-select" asp-items="ViewBag.Roles" required></select>
        <div class="form-text">Rolü değiştirip kaydettikten sonra, aşağıdaki izin listesi yeni role göre görünmesi için sayfayı yeniden aç.</div>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>

@if (User.IsInRole(RolePermissions.SuperAdmin))
{
    <div class="card mb-4">
        <div class="card-header"><strong>Şifreyi Sıfırla</strong></div>
        <div class="card-body">
            <p class="text-muted small">Kullanıcı şifresini unuttuysa veya giriş yapamıyorsa buradan yeni bir şifre belirleyebilirsin.</p>
            <form asp-action="ResetPassword" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="userId" value="@Model.Id" />
                <div class="col-auto">
                    <label class="form-label">Yeni Şifre</label>
                    <input type="text" name="newPassword" class="form-control" required minlength="6" autocomplete="new-password" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-warning">Şifreyi Sıfırla</button>
                </div>
            </form>
        </div>
    </div>

}

@if (User.HasClaim(Permissions.ClaimType, Permissions.Users.Delete))
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mb-4" data-confirm="@Model.Email hesabı silinecek. Bu işlem geri alınamaz." data-confirm-title="Kullanıcı silinsin mi?" data-confirm-ok="Kullanıcıyı Sil" data-confirm-danger>
        <button type="submit" class="btn btn-outline-danger btn-sm">Kullanıcıyı Sil</button>
    </form>
}

@if (ViewBag.RolePermissionsRole != null)
{
    <div class="card">
        <div class="card-header">
            <strong>İzinler — @RolePermissions.DisplayName((string)ViewBag.RolePermissionsRole)</strong>
        </div>
        <div class="card-body">
            <p class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>
                Bu izinler role bağlıdır: burada değiştirdiğin izinler sadece bu kullanıcıyı değil,
                <strong>@RolePermissions.DisplayName((string)ViewBag.RolePermissionsRole)</strong> rolüne sahip
                <strong>tüm kullanıcıları</strong> etkiler.
            </p>
            <form asp-action="SaveRolePermissions" method="post">
                <input type="hidden" name="userId" value="@Model.Id" />
                <input type="hidden" name="roleName" value="@ViewBag.RolePermissionsRole" />
                <div class="row g-2 mb-3">
                    @{
                        var enabledPermissions = (HashSet<string>)ViewBag.RolePermissionsEnabled;
                        var allPermissions = (IReadOnlyList<string>)ViewBag.AllPermissions;
                    }
                    @foreach (var permission in allPermissions)
                    {
                        <div class="col-md-4 col-lg-3">
                            <label class="form-check">
                                <input class="form-check-input" type="checkbox" name="selectedPermissions" value="@permission" checked="@enabledPermissions.Contains(permission)" />
                                <span class="form-check-label small">@Permissions.DisplayName(permission)</span>
                            </label>
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-sm btn-primary">İzinleri Kaydet</button>
                <a asp-area="Admin" asp-controller="Features" asp-action="Index" class="btn btn-sm btn-outline-secondary">Tüm Rolleri Özellikler Ekranında Gör</a>
            </form>
        </div>
    </div>
}
