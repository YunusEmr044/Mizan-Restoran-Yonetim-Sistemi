@model List<Reservation>
@{
    ViewData["Title"] = "Rezervasyonlar";
    ViewBag.PazarlamaActive = "reservations";
    int pendingCount = ViewBag.PendingCount;
    int totalCount = ViewBag.TotalCount;
    int pageNum = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Rezervasyon Talepleri</h2>
        <p class="text-muted small mb-0">@totalCount talep @(pendingCount > 0 ? $"· {pendingCount} onay bekliyor" : "")</p>
    </div>
</div>

@await Html.PartialAsync("_PazarlamaSubNav")

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Ad Soyad</th><th>Telefon</th><th>Tarih</th><th>Saat</th><th>Kişi</th>
                <th>Not</th><th>Durum</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td class="fw-semibold">@r.Name</td>
                <td>@r.Phone</td>
                <td>@r.Date.ToString("dd.MM.yyyy")</td>
                <td>@r.Time.ToString(@"hh\:mm")</td>
                <td>@r.PartySize</td>
                <td class="text-muted small">@r.Note</td>
                <td>
                    <span class="badge @(r.Status switch {
                        ReservationStatus.Onaylandi => "bg-success",
                        ReservationStatus.Reddedildi => "bg-danger",
                        ReservationStatus.IptalEdildi => "bg-secondary",
                        _ => "text-dark"
                    })" style="@(r.Status == ReservationStatus.Beklemede ? "background: var(--ry-accent);" : "")">@r.Status</span>
                </td>
                <td>
                    @if (User.HasClaim(Permissions.ClaimType, Permissions.Reservations.Manage))
                    {
                        <form asp-action="SetStatus" method="post" class="d-flex gap-1">
                            <input type="hidden" name="id" value="@r.Id" />
                            <select name="status" class="form-select form-select-sm">
                                @foreach (var s in Enum.GetValues<ReservationStatus>())
                                {
                                    <option value="@s" selected="@(s == r.Status)">@s</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-sm btn-outline-primary">Güncelle</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-muted">Henüz rezervasyon talebi yok.</td></tr>
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Sayfalar" class="d-flex justify-content-between align-items-center">
        <span class="text-muted small">Sayfa @pageNum / @totalPages</span>
        <div class="btn-group">
            <a class="btn btn-outline-secondary btn-sm @(pageNum <= 1 ? "disabled" : "")" asp-action="Index" asp-route-page="@(pageNum - 1)">&laquo; Önceki</a>
            <a class="btn btn-outline-secondary btn-sm @(pageNum >= totalPages ? "disabled" : "")" asp-action="Index" asp-route-page="@(pageNum + 1)">Sonraki &raquo;</a>
        </div>
    </nav>
}
