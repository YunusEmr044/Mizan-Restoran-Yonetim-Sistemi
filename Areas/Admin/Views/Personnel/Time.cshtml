@model TimeView
@{
    ViewData["Title"] = "Mesai";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h2 class="mb-0">Mesai</h2>
        <p class="text-muted small mb-0">Personelin kendi hesabından girdiği işe başlama ve çıkış kayıtları.</p>
    </div>
</div>
<form method="get" class="row g-2 align-items-end mb-3" style="max-width: 560px">
    <div class="col"><label class="form-label small" for="ryFrom">Başlangıç</label><input class="form-control" id="ryFrom" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
    <div class="col"><label class="form-label small" for="ryTo">Bitiş</label><input class="form-control" id="ryTo" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
    <div class="col-auto"><button class="btn btn-primary">Filtrele</button></div>
</form>

<h5>Toplam çalışma</h5>
<div class="table-responsive mb-4">
    <table class="table align-middle">
        <thead><tr><th>Personel</th><th class="text-end">Kayıt</th><th class="text-end">Saat</th><th></th></tr></thead>
        <tbody>
        @foreach (var t in Model.Totals)
        {
            <tr>
                <td class="fw-semibold">@t.UserName</td>
                <td class="text-end">@t.Entries</td>
                <td class="text-end">@t.Hours.ToString("0.##")</td>
                <td>@if (t.HasOpenEntry) { <span class="badge bg-warning text-dark">Çıkışı girilmemiş kayıt var</span> }</td>
            </tr>
        }
        @if (!Model.Totals.Any())
        {
            <tr><td colspan="4"><partial name="_EmptyState" model='new EmptyStateModel("bi-clock", "Bu aralıkta mesai kaydı yok. Personel, sol menünün altındaki \"Mesaim\" sayfasından işe başlar.", null, null)' /></td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.Entries.Any())
{
    <h5>Kayıtlar</h5>
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead><tr><th>Personel</th><th>Giriş</th><th>Çıkış</th><th class="text-end">Süre</th><th>Not</th></tr></thead>
            <tbody>
            @foreach (var e in Model.Entries)
            {
                <tr>
                    <td>@e.UserName</td>
                    <td>@e.ClockIn.ToString("dd.MM HH:mm")</td>
                    <td>
                        @if (e.ClockOut is { } outAt)
                        {
                            @outAt.ToString("dd.MM HH:mm")
                        }
                        else
                        {
                            <form asp-action="CloseEntry" asp-route-id="@e.Id" method="post" class="d-flex gap-1">
                                <input class="form-control form-control-sm" type="datetime-local" name="clockOut" required
                                       min="@e.ClockIn.ToString("yyyy-MM-ddTHH:mm")" max="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" style="max-width: 210px" />
                                <button class="btn btn-sm btn-outline-dark text-nowrap">Çıkışı gir</button>
                            </form>
                        }
                    </td>
                    <td class="text-end">@(e.ClockOut is { } c ? (c - e.ClockIn).TotalHours.ToString("0.##") : "—")</td>
                    <td class="small text-muted">@e.Note</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
