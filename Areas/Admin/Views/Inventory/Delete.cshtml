@model InventoryItem
@{
    ViewData["Title"] = "Malzeme Sil";
}
<h2 class="mb-4">Malzemeyi Sil</h2>
<p>"<strong>@Model.Name</strong>" malzemesini silmek istediğinize emin misiniz?</p>
<p class="text-muted small">Bu malzeme bir reçetede veya satın alma kaydında kullanılıyorsa silme işlemi engellenecektir.</p>
<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Evet, Sil</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
</form>
