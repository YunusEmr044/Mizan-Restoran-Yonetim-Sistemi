@model List<InventoryTransaction>
@{
    var item = (InventoryItem)ViewBag.Item;
    ViewData["Title"] = $"{item.Name} - Hareketler";
}
<div class="mb-3">
    <h2>@item.Name — Stok Hareketleri</h2>
    <p class="text-muted">Mevcut miktar: <strong>@item.CurrentQuantity.ToString("0.###") @item.Unit</strong></p>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Stok Listesine Dön</a>
</div>

@if (User.HasClaim(Permissions.ClaimType, Permissions.Inventory.Manage))
{
    <div class="card mb-4">
        <div class="card-body">
            <h6>Manuel Düzeltme (Sayım Farkı)</h6>
            <form asp-action="Duzelt" method="post" class="row g-2 align-items-end">
                <input type="hidden" name="id" value="@item.Id" />
                <div class="col-auto">
                    <label class="form-label small">Yeni Miktar</label>
                    <input type="number" step="0.001" name="newQuantity" class="form-control" value="@item.CurrentQuantity" required />
                </div>
                <div class="col-auto">
                    <label class="form-label small">Not</label>
                    <input type="text" name="note" class="form-control" placeholder="Örn: Sayım farkı" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">Düzelt</button>
                </div>
            </form>
        </div>
    </div>
}

<table class="table">
    <thead><tr><th>Tarih</th><th>Tür</th><th>Değişim</th><th>Not</th></tr></thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@t.Type</td>
            <td class="@(t.QuantityChange >= 0 ? "text-success" : "text-danger")">
                @(t.QuantityChange >= 0 ? "+" : "")@t.QuantityChange.ToString("0.###") @item.Unit
            </td>
            <td class="text-muted small">@t.Note</td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="4" class="text-muted">Henüz hareket yok.</td></tr>
    }
    </tbody>
</table>
