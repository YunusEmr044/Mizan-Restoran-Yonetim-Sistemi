# Bu dosyayı .env adıyla kopyalayıp doldurun:  cp .env.example .env
# .env git'e girmez (docker/.gitignore).

# SQL Server "sa" şifresi: en az 8 karakter; büyük harf, küçük harf, rakam ve sembolden en az üçünü içermeli.
DB_PASSWORD=
DB_NAME=MizanDb

# İlk Süper Admin hesabı (yalnızca veritabanında hiç kullanıcı yokken kullanılır).
# İlk girişten sonra bu iki satırı silebilirsiniz.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Uygulamanın bu bilgisayarda açılacağı port (http://localhost:5080).
APP_PORT=5080

# QR kodlarının yönleneceği adres. Restoran ağında: http://<bu bilgisayarın IP'si>:5080
# Domain ile: https://restoraniniz.com
PUBLIC_BASE_URL=http://localhost:5080

# --- Yalnızca sunucuda, domain + HTTPS ile (docker compose --profile https up -d) ---
# DOMAIN=restoraniniz.com
# REQUIRE_HTTPS=true
# ALLOWED_HOSTS=restoraniniz.com

# Production (varsayılan) boş başlar. "Development" yazarsanız örnek restoran verisi ve
# kaynak koddaki örnek hesaplar oluşturulur: YALNIZCA kendi bilgisayarınızda deneme içindir.
MIZAN_ENVIRONMENT=Production
